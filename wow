		for i = 1, math.min(f, tl:count()) do
			local list = tl:getList("Tools", i)
			if list then
				for _, e in ipairs(list) do
					any = true
					if e.Action == "Equip" then state = e.Name elseif e.Action == "Unequip" then state = false end
				end
			end
		end
		if any then self.desired = state end
	end
