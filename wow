-- HappaTAS 3.0.0 - records and replays TAS runs on the client (executor script).
-- Saves to <executor workspace>/HappaTasPort/<PlaceId>/. Press M for the menu.
-- Release build: comments and blank lines removed. The commented source is src2/ (HappaTasPort repository).
local __mods, __cache, __loading, __stack = {}, {}, {}, {}
local function import(name)
	local c = __cache[name]
	if c ~= nil then return c end
	if __loading[name] then
		local chain, from = {}, 1
		for i = 1, #__stack do
			if __stack[i] == name then from = i break end
		end
		for i = from, #__stack do chain[#chain + 1] = __stack[i] end
		chain[#chain + 1] = name
		error("HappaTAS3: import cycle: " .. table.concat(chain, " -> "), 2)
	end
	local f = __mods[name]
	if not f then error("HappaTAS3: no module " .. tostring(name), 2) end
	__loading[name] = true
	__stack[#__stack + 1] = name
	local ok, res = pcall(f, import)
	__stack[#__stack] = nil
	__loading[name] = nil
	if not ok then error(res, 0) end
	if res == nil then res = true end
	__cache[name] = res
	return res
end
