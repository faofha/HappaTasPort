			menu.Name = "Menu"
			menu.Size = UDim2.new(1, 0, 0, MENU_H)
			U.menu = menu
			U.title = text(menu, 7)
			say(U.title, "MicroProfiler", 0, 0)
			U.items = {}
			for i, def in ipairs(MENUS) do
				local it = { hl = box(menu, HOVER, 6), t = text(menu, 7), b = { f = newButton(menu, 8) } }
				it.b.f.Name = "Item" .. i
				show(it.hl, false)
				U.items[i] = it
			end
			U.readout = text(menu, 7)

			-- dropdown, tooltip and help windows
			local ddF = newFrame(root, BACK[2], 10)
			ddF.Name = "Dropdown"
			U.dd = { f = ddF }
			show(U.dd, false)
			U.tip = window(12)
			U.help = { window(11), window(11), window(11) }

			-- input. Every click, drag and wheel notch comes from UserInputService, so it counts wherever
			-- Roblox delivers it (its top bar lies over this strip of the screen). The buttons above only
			-- keep clicks on the profiler away from the game; frameUI acts on MS once per frame.
			local MB1, MB2 = Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2
			local TOUCH = Enum.UserInputType.Touch
			local function live() return P.active and root.Visible end
			local function evPos(input)
				local p = input.Position
				if typeof(p) == "Vector3" then MS.gx, MS.gy, MS.ev = p.X, p.Y, true end
			end
			on(UIS.InputBegan, function(input)
				local t = input.UserInputType
				if (t ~= MB1 and t ~= MB2 and t ~= TOUCH) or not live() then return end
				if t == TOUCH and MS.touch then return end -- one finger at a time
				evPos(input)
				local x, y = toLocal(MS.gx, MS.gy)
				if not overUI(x, y) then return end   -- a click in the game, not on the profiler
				if not (MS.downL or MS.downR) then MS.dx, MS.dy = x, y end
				if t == MB2 then
					MS.downR, MS.pressR = true, true
				else
					MS.downL, MS.pressL = true, true
					if t == TOUCH then MS.touch = input end
				end
			end)
			on(UIS.InputChanged, function(input)
				if not live() then return end
				local t = input.UserInputType
				if t == Enum.UserInputType.MouseMovement or (t == TOUCH and input == MS.touch) then
					evPos(input)
				elseif t == Enum.UserInputType.MouseWheel then
					evPos(input)
					local z = input.Position.Z
					if z > 0 then MS.wheel = MS.wheel + 1 elseif z < 0 then MS.wheel = MS.wheel - 1 end
				end
			end)
			on(UIS.InputEnded, function(input)
				local t = input.UserInputType
				local right = (t == MB2)
				if right then
					if not MS.downR then return end
				elseif t == MB1 or (t == TOUCH and input == MS.touch) then
					if not MS.downL then return end
				else
					return
				end
				evPos(input)
				if right then MS.downR = false else MS.downL = false end
				if t == TOUCH then MS.touch = nil end
				local x, y = toLocal(MS.gx, MS.gy)
				if math.abs(x - MS.dx) + math.abs(y - MS.dy) < ((t == TOUCH) and 12 or 3) then
					if right then MS.clickR = true else MS.clickL = true end
				end
			end)
			local function resized()
				local s = root.AbsoluteSize
				if s.X > 0 and s.Y > 0 then
					W, H = s.X / SCALE, s.Y / SCALE
					U.barsDirty = true
				end
			end
			root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resized)
			resized()
			layoutMenuBar()
			return true
		end

		-- -------------------------------------------------------------------------------- modes
		local function flamePlace()
			if not U.built then return end
			local y = DET_Y + ((cfg.mode == "Detailed") and DET_H or 0)
			U.flm.y = y
			if U.flm.py ~= y then U.flm.py = y; U.flm.f.Position = UDim2.fromOffset(0, y) end
			show(U.flm, cfg.flame and graphVisible())
		end
		local function applyMode()
			if not U.built then return end
			local gv = graphVisible()
			show(U.graph, gv)
			show(U.close, gv)
			show(U.det, cfg.mode == "Detailed" and gv and not cfg.custom)
			show(U.tim, cfg.mode == "Timers")
			show(U.cnt, cfg.mode == "Counters")
			slog.on = (cfg.mode == "Detailed") and P.active and not cfg.custom
			U.barsDirty = true
			timersDirty = true
			hlKey = nil
			if not gv then windowHide(U.tip) end
			flamePlace()
		end
		actions.applyMode = applyMode
		function P.SetMode(m)
			for _, v in ipairs(MODES) do
				if v == m then
					cfg.mode = m
					applyMode()
					P.SaveConfig()
					return true
				end
			end
			return false
		end
		function P.Close()
			Settings.Set("Show MicroProfiler", 0)
			if P.active then P.SetVisible(false) end
		end
		function P.TogglePause()
			paused = not paused
		end
		function P.IsPaused() return paused end

		-- -------------------------------------------------------------------------------- per frame
		local tick = 0
		local function readMouse()
			mx, my = toLocal(pointer())
		end
		-- MicroProfileMoveGraph: one wheel notch zooms by 1.05 (1.40 with Shift) around the mouse
		local function zoom(dir)
			local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
			local fct = shift and 1.40 or 1.05
			local old = view.range
			if dir > 0 then view.range = view.range * fct else view.range = mmax(view.range / fct, 1e-4) end
			view.range = mmin(view.range, 10000)
			view.offset = view.offset + (old - view.range) * mmax(mx / W, 0)
		end
		local function clearClicks()
			MS.pressL, MS.pressR, MS.clickL, MS.clickR, MS.wheel = false, false, false, false, 0
		end
		local function readoutUpdate()
			local t, a, m = lastMs, readAvg(), RO.max
			if cfg.custom then t, a, m = tasReadout() end
			local s = sfmt("Time[%6.2f] Avg[%6.2f] Max[%6.2f]", t, a, m)
			say(U.readout, s, floor(W - #s * CW), 0)
		end
		local function helpUpdate()
			local h = U.help
			if not helpOn then
				windowHide(h[1]); windowHide(h[2]); windowHide(h[3])
				return
			end
			if graphVisible() then
				windowShow(h[1], W, 20, { { "Left-Click", "Center View" }, { "Right-Click", "Zoom to frame" } }, SEP)
				windowShow(h[2], W, HIST_H + 20, { { "Drag", "Pan View" }, { "Mouse Wheel", "Zoom" },
					{ "F6", "Show / Hide" }, { "Ctrl+P", "Pause" } }, SEP)
			else
				windowHide(h[1])
				windowShow(h[2], W, HIST_H + 20, { { "F6", "Show / Hide" }, { "Ctrl+P", "Pause" } }, SEP)
			end
			windowShow(h[3], 0, H - 10, { { "Memory Usage", sfmt("%4.2fmb", luaHeapMb()) }, { "Frames", tostring(K) } }, SEP)
		end
		local function frameUI(recorded)
			tick = tick + 1
			readMouse()
			-- a release Roblox never delivered (the window lost focus with a button held)
			if MS.downL and not MS.touch and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then MS.downL = false end
			if MS.downR and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then MS.downR = false end
			layoutMenuBar()
			updateMenus()
			if not P.active then return end -- a menu line closed the profiler (Mode > Off)
			local gv = graphVisible()
			local overTip = false
			local detailed = cfg.mode == "Detailed" and gv and not cfg.custom
			local inDet = detailed and activeMenu == nil and mx >= 0 and mx < W and my >= DET_Y and my < DET_Y + DET_H
			if gv then
				if cfg.custom then
					tasStep()
				elseif U.barsDirty then
					U.barsDirty = false
					redrawLive()
				elseif recorded then
					drawBar(K, HIS.ms[hi(K)], liveSeq(K))
					setStrip(K - NUM_FRAMES + 1)
				end
				-- the view moves before the green selection is drawn (MicroProfileDraw: MoveGraph, then
				-- the clicks of DrawDetailedView, then the frame history)
				if detailed then
					-- MicroProfileMoveGraph: dragging pans, the wheel zooms around the mouse
					if inDet and MS.pressL then det.drag = mx end
					if det.drag then
						if not MS.downL then
							det.drag = nil
						else
							view.offset = view.offset - (mx - det.drag) * view.range / W
							det.drag = mx
						end
					end
					if inDet and MS.wheel ~= 0 then
						local n = MS.wheel
						for _ = 1, math.abs(n) do zoom((n > 0) and -1 or 1) end
					end
					local dh = det.hover
					if dh and inDet and MS.clickR and K >= 1 then -- a right click on a scope zooms to it
						view.offset = (dh.t0 - baseStart()) * 1000
						view.range = mmax(dh.ms, 0.01)
					end
				end
				local k = hoverUpdate()
				if k then overTip = true end
				-- MicroProfileDrawDetailedView: while the left button is held over the graph the detailed
				-- view stays centred on the frame under the mouse (UI.nMouseDownLeft), a right click zooms
				-- to that frame (UI.nMouseRight). The TAS Timeline scrubs instead (past the end of the TAS
				-- = its last frame).
				local back, frac = graphIndex()
				if back and (MS.downL or MS.pressL or MS.clickR) then
					if cfg.custom then
						local data = tasData()
						if tas.a and P.OnScrub and type(data) == "table" and #data > 0 then
							P.OnScrub(clampn(tas.a + NUM_FRAMES - 1 - back, 1, #data))
						end
					elseif k and K >= 1 then
						local st, en = HIS.start[hi(k)], frameEnd(k)
						if MS.clickR then
							view.offset = (st - baseStart()) * 1000
							view.range = mmax((en - st) * 1000, 0.01)
						else
							view.offset = (st + (en - st) * frac - baseStart()) * 1000 - 0.5 * view.range
						end
					end
				end
				-- the close box right of the graph
				if (MS.clickL or MS.clickR) and activeMenu == nil and mx >= W - CLOSE_W and mx < W and my >= MENU_H and my < MENU_H + HIST_H then
					P.Close()
					return
				end
				if not cfg.custom then updateHighlight() end
			else
				setHover(nil)
			end
			readoutUpdate()
			if detailed then
				if tick % 2 == 0 or det.drag then detailUpdate(activeMenu == nil and not overTip) end
				if det.hover and not overTip then
					windowShow(U.tip, mx, my + 20, timerTip(det.hover.name, det.hover.ms), WHITE)
					overTip = true
				end
			end
			if cfg.mode == "Timers" then
				if tick % 6 == 0 or timersDirty then timersUpdate() end
				if tim.hover and activeMenu == nil then
					windowShow(U.tip, mx, my + 20, timerTip(TIMERS[tim.hover].name), WHITE)
					overTip = true
				end
			end
			if cfg.mode == "Counters" and (tick % 15 == 0 or countersDirty) then
				countersDirty = false
				countersUpdate()
			end
			if cfg.flame and gv then
				flamePlace()
				if tick % 15 == 0 or flm.n == 0 then flameUpdate(false) end
				if activeMenu == nil and not overTip and U.flm.y and my >= U.flm.y and my < U.flm.y + 3 * BAR_H then
					flameUpdate(true)
					local h = flm.hover
					if h then
						windowShow(U.tip, mx, my + 20, { { h.name, "" }, { "Average", sfmt("%6.3fms", h.ms) } }, WHITE)
						overTip = true
					end
				end
			elseif U.flm.vis then
				show(U.flm, false)
			end
			if not overTip then windowHide(U.tip) end
			if dd.menu and tick % 15 == 0 then actions.ddRender(dd.menu) end
			helpUpdate()
		end

		-- called at the start of every frame (PreRender) with the render delta
		function P.FrameBegin(dt)
			frameNo = frameNo + 1
			if not P.active then
				clearAcc()
				return
			end
			local t0 = clock()
			local recorded = flip(dt, t0)
			if U.built and U.root.Visible then
				local ok, err = pcall(frameUI, recorded)
				if not ok then log("MicroProfiler:", tostring(err)) end
			end
			clearClicks() -- clicks last one frame (UI.nMouseLeft = UI.nMouseRight = 0 after drawing)
			clearAcc()
			tAcc.Profiler = clock() - t0
			tCnt.Profiler = 1
		end

		function P.SetVisible(v)
			v = v and true or false
			if v and not build() then return end
			P.active = v
			if U.root then U.root.Visible = v end
			lastStart = nil
			for k in pairs(tStart) do tStart[k] = nil end
			if v then
				applyMode()
			else
				slog.on = false
				activeMenu, helpOn, det.drag = nil, false, nil
				MS.downL, MS.downR, MS.touch = false, false, nil
				clearClicks()
				if U.built then
					ddClose()
					windowHide(U.tip)
					for _, w in ipairs(U.help) do windowHide(w) end
					setHover(nil)
				end
			end
		end

		-- true when the mouse is over any part of the profiler (inputs are not recorded there).
		-- m is a screen point (UIS:GetMouseLocation space); the current mouse uses the profiler's own pointer.
		function P.IsMouseOver(m)
			if not P.active or not U.built or not U.root.Visible then return false end
			local gx, gy
			local okc, cur = pcall(UIS.GetMouseLocation, UIS)
			if typeof(m) ~= "Vector2" or (okc and typeof(cur) == "Vector2" and cur.X == m.X and cur.Y == m.Y) then
				gx, gy = pointer()
			else
				local ix, iy = guiInset()
				gx, gy = m.X - ix, m.Y - iy
			end
			return overUI(toLocal(gx, gy))
		end

		-- -------------------------------------------------------------------------------- dump
		local function htmlEscape(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
		function actions.dump(n)
			local rows = {}
			local title
			if cfg.custom then
				local data, f = tasData()
				if type(data) == "table" and #data > 0 then
					f = clampn(math.floor(tonumber(f) or #data), 1, #data)
					for k = mmax(1, f - n + 1), f do
						local fr = data[k]
						rows[#rows + 1] = { k, tasFrameMs(fr), 0, 0, 0, 0, 0, fr.TotalTime or 0 }
					end
				end
				title = "TAS frame times"
			else
				for k = mmax(1, K - mmin(n, MAX_HISTORY) + 1), K do
					local i = hi(k)
					rows[#rows + 1] = { HIS.no[i], HIS.ms[i], HIS.gpu[i], HIS.ren[i], HIS.job[i], HIS.phy[i], HIS.hap[i] }
				end
				if cfg.dumpIncomplete and lastStart then
					rows[#rows + 1] = { frameNo, (clock() - lastStart) * 1000, 0, 0, 0, 0, 0, incomplete = true }
				end
				title = "MicroProfiler frames"
			end
			local avg, peak = readAvg(), RO.max
			local name = "microprofile-" .. os.date("%Y%m%d-%H%M%S")
			local textOut, ext
			if cfg.dumpBinary then
				-- LibMP is Roblox's own binary format; the closest open format is CSV
				local out = { "frame,cpu_ms,gpu_ms,render_ms,jobs_ms,physics_ms,happatas_ms" }
				for _, r in ipairs(rows) do
					out[#out + 1] = sfmt("%d,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f%s", r[1], r[2], r[3], r[4], r[5], r[6], r[7], r.incomplete and ",incomplete" or "")
				end
				textOut, ext = table.concat(out, "\n") .. "\n", "csv"
			elseif cfg.dumpLegacy then
				local out = { "HappaTAS " .. VERSION .. " " .. title, sfmt("frames %d  avg %.2f ms  max %.2f ms  aggregate %s",
					#rows, avg, peak, (cfg.aggregate == 0) and "infinite" or tostring(cfg.aggregate)), "",
					sfmt("%10s %9s %9s %9s %9s %9s %9s", "frame", "cpu", "gpu", "render", "jobs", "physics", "happatas") }
				for _, r in ipairs(rows) do
					out[#out + 1] = sfmt("%10d %9.3f %9.3f %9.3f %9.3f %9.3f %9.3f%s", r[1], r[2], r[3], r[4], r[5], r[6], r[7], r.incomplete and " incomplete" or "")
				end
				textOut, ext = table.concat(out, "\n") .. "\n", "txt"
			else
				local mxv = 0
				for _, r in ipairs(rows) do if r[2] > mxv then mxv = r[2] end end
				local bw = 4
				local svg = { sfmt("<svg width=\"%d\" height=\"120\" viewBox=\"0 0 %d 120\">", mmax(1, #rows * bw), mmax(1, #rows * bw)) }
				for i, r in ipairs(rows) do
					local h = (mxv > 0) and floor(r[2] / mxv * 118 + 0.5) or 0
					local col = (r[5] >= r[4]) and "#ff7f27" or "#37a0ee"
					svg[#svg + 1] = sfmt("<rect x=\"%d\" y=\"%d\" width=\"%d\" height=\"%d\" fill=\"%s\"><title>%s %.2fms</title></rect>",
						(i - 1) * bw, 120 - h, bw - 1, h, col, htmlEscape(tostring(r[1])), r[2])
				end
				svg[#svg + 1] = "</svg>"
				local tbl = { "<table><tr><th>frame</th><th>cpu ms</th><th>gpu ms</th><th>render ms</th><th>jobs ms</th><th>physics ms</th><th>HappaTAS ms</th></tr>" }
				for _, r in ipairs(rows) do
					tbl[#tbl + 1] = sfmt("<tr><td>%s</td><td>%.3f</td><td>%.3f</td><td>%.3f</td><td>%.3f</td><td>%.3f</td><td>%.3f</td></tr>",
						htmlEscape(tostring(r[1]) .. (r.incomplete and " (incomplete)" or "")), r[2], r[3], r[4], r[5], r[6], r[7])
				end
				tbl[#tbl + 1] = "</table>"
				textOut = table.concat({
					"<!doctype html><html><head><meta charset=\"utf-8\"><title>", htmlEscape(name), "</title><style>",
					"body{background:#313131;color:#fff;font:12px 'Roboto Mono',monospace;margin:16px}",
					"svg{background:#474747;display:block;margin:12px 0}table{border-collapse:collapse}",
					"th{background:#474747}td,th{padding:2px 10px;text-align:right;border-bottom:1px solid #474747}",
					"</style></head><body><h3>HappaTAS ", htmlEscape(VERSION), " - ", htmlEscape(title), "</h3>",
					sfmt("<p>%d frames, Avg %.2f ms, Max %.2f ms, Aggregate %s, Place %s</p>", #rows, avg, peak,
						(cfg.aggregate == 0) and "Infinite" or tostring(cfg.aggregate), htmlEscape(tostring(game.PlaceId))),
					table.concat(svg), table.concat(tbl), "</body></html>",
				})
				ext = "html"
			end
			local ok, res = Store.WriteText(name, textOut, ext)
			if Core.SetStatus then
				task.spawn(Core.SetStatus, ok and ("Dumped " .. #rows .. " frames to " .. name .. "." .. ext) or ("Dump failed: " .. tostring(res)))
			end
			return ok, res, ext
		end
		P.Dump = function(n) return actions.dump(tonumber(n) or 128) end

		-- -------------------------------------------------------------------------------- config + presets
		local function inList(v, list)
			for _, x in ipairs(list) do if x == v then return true end end
			return false
		end
		local function nearest(v, list)
			local best, bd = list[1], HUGE
			for _, x in ipairs(list) do
				local d = math.abs(x - v)
				if d < bd then best, bd = x, d end
			end
			return best
		end
		-- copies only valid values from t (a saved table, maybe from an older version) into c
		local function readConfig(t, c)
			if type(t) ~= "table" then return c end
			local mode = t.mode
			if mode == "Frame Graph" then mode = "Frame" end
			if mode == "TAS Timeline" then mode = "Frame"; c.custom = true end
			if inList(mode, MODES) then c.mode = mode end
			local a = tonumber(t.aggregate)
			if a then
				if a >= 1e9 then a = 0 end -- V2.35 saved Infinite as 1e9
				c.aggregate = inList(a, AGG) and a or nearest(a, AGG)
			end
			local ref = tonumber(t.ref)
			if ref and inList(ref, REF) then c.ref = ref end
			local bg, fg = tonumber(t.bg), tonumber(t.fg)
			if bg and inList(bg, OPAC) then c.bg = bg end
			if fg and inList(fg, OPAC) then c.fg = fg end
			local bars = tonumber(t.bars)
			if bars and bars >= 0 and bars <= 255 and bars % 1 == 0 then c.bars = bars end
			local net = tonumber(t.network)
			if net and (net == 0 or net == 1 or net == 2) then c.network = net end
			for _, k in ipairs({ "force", "spikes", "all", "flame", "custom", "dumpIncomplete", "dumpLegacy", "dumpBinary" }) do
				if type(t[k]) == "boolean" then c[k] = t[k] end
			end
			if type(t.groups) == "table" then
				for _, g in ipairs(GROUPS) do
					if type(t.groups[g]) == "boolean" then c.groups[g] = t.groups[g] end
				end
			end
			return c
		end
		-- what a preset stores (the dump options and the Custom view stay as they are)
		local function snapshotOf(c)
			return { mode = c.mode, aggregate = c.aggregate, ref = c.ref, bg = c.bg, fg = c.fg, spikes = c.spikes,
				bars = c.bars, all = c.all, groups = { Engine = c.groups.Engine, HappaTAS = c.groups.HappaTAS },
				network = c.network, flame = c.flame, force = c.force }
		end
		local function snapshot() return snapshotOf(cfg) end
		local function applied()
			U.barsDirty, timersDirty, countersDirty = true, true, true
			applyMode()
		end
		function actions.savePreset(name)
			if not inList(name, PRESET_NAMES) then return end
			presets[name] = snapshot()
			P.SaveConfig()
			if Core.SetStatus then task.spawn(Core.SetStatus, "MicroProfiler preset '" .. name .. "' saved") end
		end
		function actions.loadPreset(name)
			if not inList(name, PRESET_NAMES) then return end
			local p = presets[name]
			if p then
				local before = cfg.aggregate
				readConfig(p, cfg)
				if cfg.aggregate == 0 and before ~= 0 then pickInfinite() end
			elseif name == "Default" then
				local keep = { custom = cfg.custom, dumpIncomplete = cfg.dumpIncomplete, dumpLegacy = cfg.dumpLegacy, dumpBinary = cfg.dumpBinary }
				cfg = defaults()
				for k, v in pairs(keep) do cfg[k] = v end
			else
				if Core.SetStatus then task.spawn(Core.SetStatus, "MicroProfiler preset '" .. name .. "' is empty (use Save first)") end
				return
			end
			applied()
			P.SaveConfig()
		end
		P.LoadPreset, P.SavePreset = actions.loadPreset, actions.savePreset

		function P.Config() return cfg end
		function P.LoadConfig(t)
			if type(t) ~= "table" then return end
			cfg = readConfig(t, defaults())
			-- V2.35 stored the graph scale as "scale"
			if t.ref == nil and tonumber(t.scale) then
				local s = tonumber(t.scale)
				for _, v in ipairs(REF) do if math.abs(v - s) < 0.02 then cfg.ref = v end end
			end
			presets = {}
			if type(t.presets) == "table" then
				for _, n in ipairs(PRESET_NAMES) do
					if type(t.presets[n]) == "table" then presets[n] = snapshotOf(readConfig(t.presets[n], defaults())) end
				end
			end
			if U.built then applied() end
		end
		function P.SerializeConfig()
			local out = snapshot()
			out.custom = cfg.custom
			out.dumpIncomplete, out.dumpLegacy, out.dumpBinary = cfg.dumpIncomplete, cfg.dumpLegacy, cfg.dumpBinary
			local ps = {}
			local any = false
			for n, p in pairs(presets) do
				local copy = {}
				for k, v in pairs(p) do copy[k] = v end
				copy.groups = { Engine = p.groups.Engine, HappaTAS = p.groups.HappaTAS }
				ps[n] = copy
				any = true
			end
			if any then out.presets = ps end
			return out
		end
		P.SaveConfig = function() end -- replaced by the start code (saves Settings.json)

		-- read-only view of the numbers (the tests and the stats panel use it)
		function P.Snapshot()
			return { time = lastMs, avg = readAvg(), max = RO.max, onBar = mmin(K, NUM_FRAMES),
				aggAvg = (AG.dframes > 0) and (AG.dsum / AG.dframes) or 0, aggMax = AG.dmax,
				frames = AG.dframes, count = AG.count, recorded = K, frameNo = frameNo, paused = paused,
				offset = view.offset, range = view.range, hover = hoverK }
		end
		-- one timer's numbers: last frame, and the shown aggregate window (same values as Timers mode)
		function P.TimerStats(name)
			local j = TI[name]
			if not j then return nil end
			local fr = mmax(AG.dframes, 1)
			return { time = TV.last[j], calls = TV.lastC[j], exclusive = TV.lastX[j], avg = TV.dT[j] / fr,
				max = TV.dMax[j], min = TV.dMin[j], callAvg = TV.dT[j] / mmax(TV.dC[j], 1), group = TIMERS[j].group }
		end
		-- moves the detailed view (offset / range in ms from the current frame), like dragging and zooming
		function P.SetView(offset, range)
			offset, range = tonumber(offset), tonumber(range)
			if offset and offset == offset and math.abs(offset) < 1e7 then view.offset = offset end
			if range and range == range and range >= 1e-4 and range <= 10000 then view.range = range end
		end
		function P.Internals() return U, { det = det, tim = tim, cnt = cnt, flm = flm, dd = dd, tas = tas, view = view, menuX = menuX } end

		-- the whole profiler is drawn in Roblox's pixel sizes and scaled with one UIScale
		function P.SetScale(s)
			s = clampn(tonumber(s) or 1, 0.5, 4)
			if s ~= s then s = 1 end
			SCALE = s
			if U.built then
				U.scale.Scale = s
				U.root.Size = UDim2.new(1 / s, 0, 1 / s, 0)
				local a = U.root.AbsoluteSize
				if a.X > 0 and a.Y > 0 then W, H = a.X / s, a.Y / s end
				U.barsDirty, timersDirty, countersDirty = true, true, true
			end
		end

		function P.Start()
			P.SetScale(Settings.Get("MicroProfiler Scale"))
			Settings.Changed("MicroProfiler Scale", function(v) P.SetScale(v) end)
			P.SetTextNudge(Settings.Get("MicroProfiler Text Offset"))
			Settings.Changed("MicroProfiler Text Offset", function(v) P.SetTextNudge(v) end)
			P.SetVisible(Settings.On("Show MicroProfiler"))
			Settings.Changed("Show MicroProfiler", function(v) P.SetVisible(v ~= 0) end)
		end
	end
	profilerModule()
end

-- ================================================================================================
--  TAS CORE   (modes, recording, playback)
--  1 = Idle, 2 = Create (paused / recording), 3 = Test (playback)
--
--  Recording, per frame:   PreRender      new frame: camera, velocity, zoom, inputs, mouse, times
--                          PreSimulation  root CFrame, state, animation, client objects, tools,
--                                         buttons, death   (before physics moves anything)
--                          Heartbeat      bookkeeping, stats
--  Playback: Heartbeat advances the timer and poses the character for physics, PreRender poses
--  it again for rendering at the same time, the end of the render step re-asserts client objects.
-- ================================================================================================
local C = {
	data = {}, mode = 1, frame = 1, paused = true, back = false, forw = false,
	LastPause = 1, FirstFrameRecord = false, LastFrameTime = 0, LookAround = false,
	TestingTimer = 0, CurrentFrameInput = false, InputDebounce = 0, FreezeTimeRemaining = 0,
	merge = false, mergeBefore = {}, mergeAfter = {}, oldTAS = {}, mergeReqDist = nil, mergeCFrame = nil,
	mergeCanComplete = false, mergeBaseHeld = nil, hitboxes = {},
	Humanoid = nil, Char = nil, HRP = nil, IsMobile = UIS.TouchEnabled, QuitTestEvent = nil,
	dataVersion = 0, inputs = {}, poseT = nil, pose = nil, guardFrames = 0,
}
Core.State = C

do
	local NumberToState = {
		[0] = "FallingDown", [8] = "Running", [10] = "RunningNoPhysics", [12] = "Climbing",
		[11] = "StrafingNoPhysics", [1] = "Ragdoll", [2] = "GettingUp", [3] = "Jumping", [7] = "Landed",
		[6] = "Flying", [5] = "Freefall", [13] = "Seated", [14] = "PlatformStanding", [15] = "Dead",
		[4] = "Swimming", [16] = "Physics", [18] = "None",
	}
	C.NumberToState = NumberToState

	local function GetSetting(name) return Settings.Get(name) end
	C.GetSetting = GetSetting

	function C.SetCam()
		return (C.mode == 3 and Settings.On("Lock Camera (Test)")) or (C.mode == 2 and Settings.On("Lock Camera (Paused)"))
	end

	function C.DataChanged()
		C.dataVersion = C.dataVersion + 1
		ClientObjects.Invalidate()
		Buttons.Invalidate()
	end

	function C.CharLoaded()
		local h = C.HRP
		return C.Char ~= nil and h ~= nil and h.Parent ~= nil and C.Humanoid ~= nil
	end

	function C.NotDead()
		if Settings.On("Record Death & Respawn") then return true end
		return C.Humanoid ~= nil and C.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead
	end

	-- ------------------------------------------------------------------------------------ conversions
	function C.Vector3ToTable(V) return { r(V.X, 1000), r(V.Y, 1000), r(V.Z, 1000) } end
	function C.TableToVector3(t) return Vector3.new(t[1] or 0, t[2] or 0, t[3] or 0) end
	function C.CFrameToTable(cf)
		local x, y, z, a, b, c2, d, e, f, g, h, i = cf:GetComponents()
		return { r(x, 1000), r(y, 1000), r(z, 1000), r(a, 1000), r(b, 1000), r(c2, 1000), r(d, 1000), r(e, 1000), r(f, 1000), r(g, 1000), r(h, 1000), r(i, 1000) }
	end
	function C.TableToCFrame(t)
		if not t then return CFrame.new() end
		return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
	end

	function C.ToTime(t)
		t = tonumber(t) or 0
		local mins = math.floor(t / 60)
		local secs = r(t - mins * 60, 1000)
		local s = tostring(secs)
		local intPart = s:match("^%-?(%d+)") or "0"
		if #intPart < 2 then s = "0" .. s end
		return mins .. ":" .. s
	end

	-- ------------------------------------------------------------------------------------ status text
	local statusToken = 0
	function C.SetStatus(text, inverse)
		local gui = C.Gui
		if not gui then return end
		local status = gui:FindFirstChild("Status")
		if not status then return end
		statusToken = statusToken + 1
		local my = statusToken
		status.Text = tostring(text)
		if not inverse then
			status.TextTransparency = 0
			for i = 0, 1.05, 0.05 do
				if statusToken ~= my or Janitor.unloading then return end
				status.TextTransparency = i
				task.wait(0.05)
			end
		else
			status.TextTransparency = 0
			task.wait(2)
			for i = 0, 1.05, 0.05 do
				if statusToken ~= my or Janitor.unloading then return end
				status.TextTransparency = i
				task.wait(0.05)
			end
		end
	end
	Core.SetStatus = function(text, inverse) return C.SetStatus(text, inverse) end

	-- ------------------------------------------------------------------------------------ stats panels
	local lastText = setmetatable({}, { __mode = "k" })
	local function setText(lbl, text)
		if lbl and lastText[lbl] ~= text then
			lastText[lbl] = text
			lbl.Text = text
		end
	end
	local function setVisible(f, v)
		if f and f.Visible ~= v then f.Visible = v end
	end
	local statsTick = 0
	local keysCache = { frame = -1, data = nil, text = "-", t = 0 }

	local function PausedKeysText(frameNo)
		if keysCache.data ~= C.data or keysCache.frame ~= frameNo then
			local now = os.clock()
			if keysCache.data ~= C.data or now - keysCache.t > 0.1 then
				keysCache.data, keysCache.frame, keysCache.t = C.data, frameNo, now
				keysCache.text = InputSys.Describe(InputSys.HeldAt(C.data, frameNo))
			end
		end
		return keysCache.text
	end
	local function MouseText(fr)
		if fr and fr.MX then return fr.MX .. ", " .. fr.MY end
		local x, y = InputSys.Mouse()
		return x .. ", " .. y
	end
	local function v3txt(v) return r(v.X, 1000) .. ", " .. r(v.Y, 1000) .. ", " .. r(v.Z, 1000) end

	local SS = {}
	function SS.Hide()
		setVisible(C.IdleStatsF, false)
		setVisible(C.CreateStatsF, false)
		setVisible(C.TestStatsF, false)
	end

	function SS.Idle(FrameTime, zoom)
		local root = C.HRP
		local f = C.IdleStatsF
		if not root or not f then return end
		setVisible(f, true)
		setVisible(C.CreateStatsF, false)
		setVisible(C.TestStatsF, false)
		local CAX, CAY, CAZ = workspace.CurrentCamera.CFrame:ToEulerAnglesYXZ()
		local o = root.Orientation
		setText(f["1"], " Frame Time: " .. r(FrameTime or 0, 1000000))
		setText(f["2"], " Root Position: " .. v3txt(root.Position))
		setText(f["3"], " Root Rotation: " .. v3txt(o))
		setText(f["4"], " Root Linear Velocity: " .. v3txt(root.AssemblyLinearVelocity))
		setText(f["5"], " Root Angular Velocity: " .. v3txt(root.AssemblyAngularVelocity))
		setText(f["6"], " Camera Rotation: " .. r(math.deg(CAX), 1000) .. ", " .. r(math.deg(CAY), 1000) .. ", " .. r(math.deg(CAZ), 1000))
		setText(f["7"], " Humanoid State: " .. (C.Humanoid and C.Humanoid:GetState().Name or "None"))
		setText(f["8"], " Zoom: " .. r(zoom or 12.5, 1000))
	end

	function SS.Create(pausedNow, frameNo, FrameData)
		local f = C.CreateStatsF
		setVisible(C.IdleStatsF, false)
		setVisible(f, true)
		setVisible(C.TestStatsF, false)
		local bt = pausedNow and 0.1 or 0.2
		if f.BackgroundTransparency ~= bt then f.BackgroundTransparency = bt end
		setText(f["1"], " Frame: " .. frameNo)
		if FrameData and FrameData.FrameTime and FrameData.Cframe and NumberToState[FrameData.State] then
			local rootCF = C.TableToCFrame(FrameData.Cframe)
			local AX, AY, AZ = rootCF:ToEulerAnglesYXZ()
			local CAX, CAY, CAZ = C.TableToCFrame(FrameData.CamCframe):ToEulerAnglesYXZ()
			local cf, lin, ang = FrameData.Cframe, FrameData.Velocity.Linear, FrameData.Velocity.Angular
			setText(f["2"], " Frame Time: " .. FrameData.FrameTime)
			setText(f["3"], " Total Time: " .. C.ToTime(FrameData.TotalTime))
			setText(f["4"], " Root Position: " .. r(cf[1], 1000) .. ", " .. r(cf[2], 1000) .. ", " .. r(cf[3], 1000))
			setText(f["5"], " Root Rotation: " .. r(math.deg(AX), 1000) .. ", " .. r(math.deg(AY), 1000) .. ", " .. r(math.deg(AZ), 1000))
			setText(f["6"], " Root Linear Velocity: " .. lin[1] .. ", " .. lin[2] .. ", " .. lin[3])
			setText(f["7"], " Root Angular Velocity: " .. ang[1] .. ", " .. ang[2] .. ", " .. ang[3])
			setText(f["8"], " Camera Rotation: " .. r(math.deg(CAX), 1000) .. ", " .. r(math.deg(CAY), 1000) .. ", " .. r(math.deg(CAZ), 1000))
			setText(f["9"], " Humanoid State: " .. NumberToState[FrameData.State])
			setText(f["91"], " Zoom: " .. tostring(FrameData.Zoom))
			setText(f["92"], " Keys: " .. (pausedNow and PausedKeysText(frameNo) or InputSys.Describe(InputSys.Live.held)))
			setText(f["93"], " Mouse: " .. MouseText(FrameData))
		else
			local root = C.HRP
			if not root then return end
			local CAX, CAY, CAZ = workspace.CurrentCamera.CFrame:ToEulerAnglesYXZ()
			setText(f["2"], " Frame Time: 0")
			setText(f["3"], " Total Time: 0")
			setText(f["4"], " Root Position: " .. v3txt(root.Position))
			setText(f["5"], " Root Rotation: " .. v3txt(root.Orientation))
			setText(f["6"], " Root Linear Velocity: " .. v3txt(root.AssemblyLinearVelocity))
			setText(f["7"], " Root Angular Velocity: " .. v3txt(root.AssemblyAngularVelocity))
			setText(f["8"], " Camera Rotation: " .. r(math.deg(CAX), 1000) .. ", " .. r(math.deg(CAY), 1000) .. ", " .. r(math.deg(CAZ), 1000))
			setText(f["9"], " Humanoid State: " .. (C.Humanoid and C.Humanoid:GetState().Name or "None"))
			setText(f["91"], " Zoom: " .. r(Bridge.GetZoom(), 1000))
			setText(f["92"], " Keys: " .. InputSys.Describe(InputSys.Live.held))
			setText(f["93"], " Mouse: " .. MouseText(nil))
		end
	end

	function SS.Merge(reqDist, goalCFrame, FrameData)
		local m = C.MergeStats
		if type(FrameData) == "table" and FrameData.Cframe and goalCFrame then
			local dist = (Vector3.new(FrameData.Cframe[1], FrameData.Cframe[2], FrameData.Cframe[3]) - Vector3.new(goalCFrame[1], goalCFrame[2], goalCFrame[3])).Magnitude
			setText(m["1"], " Current Distance: " .. r(dist, 1000))
			if dist < reqDist then
				setText(m["3"], " Click here to complete merge")
				m.BackgroundColor3 = Color3.fromRGB(0, 80, 0)
				C.mergeCanComplete = true
			else
				setText(m["3"], " Click here to cancel merge")
				m.BackgroundColor3 = Color3.fromRGB(100, 0, 0)
				C.mergeCanComplete = false
			end
		end
		setText(m["2"], " Distance Required: " .. r(reqDist or 0, 1000))
	end

	function SS.Test(Timer, Speed)
		local f = C.TestStatsF
		setVisible(C.IdleStatsF, false)
		setVisible(C.CreateStatsF, false)
		setVisible(f, true)
		setText(f["1"], " Time: " .. C.ToTime(r(Timer or 0, 1000000)))
		setText(f["2"], " Playback Speed: " .. tostring(Speed or 1))
		setText(f["3"], " Keys: " .. InputSys.Describe(InputSys.Replay.state))
		setText(f["4"], " Mouse: " .. MouseText(C.data[C.frame]))
	end

	-- every frame while paused (values change on scrub), ~30 times a second otherwise
	function C.SetStats(statMode, FrameData, FrameTime, frameNo)
		statsTick = statsTick + 1
		local mode3speed = (statMode == "Test" and Settings.Get("Playback Speed") ~= 1)
		if Settings.On("Show Stats (" .. statMode .. ")") or mode3speed then
			if statMode == "Create" and C.paused then
				SS.Create(true, frameNo, FrameData)
			elseif statsTick % 2 == 0 then
				Profiler.Begin("Stats UI")
				if statMode == "Idle" then SS.Idle(FrameTime, Bridge.GetZoom())
				elseif statMode == "Create" then SS.Create(C.paused, frameNo, FrameData)
				elseif statMode == "Test" then SS.Test(C.TestingTimer, Settings.Get("Playback Speed")) end
				Profiler.End("Stats UI")
			end
		else
			SS.Hide()
		end
		if C.merge then
			SS.Merge(C.mergeReqDist, C.mergeCFrame, FrameData)
			setVisible(C.MergeStats, true)
		else
			setVisible(C.MergeStats, false)
		end
	end

	-- ------------------------------------------------------------------------------------ character
	-- moves the whole character (the root moves the assembly; the torso is aligned through the
	-- root joint so the limbs never trail a frame behind)
	function C.SyncCharacter(hrpCF, linVel, angVel)
		local HRP = C.HRP
		if not HRP or not HRP.Parent then return end
		HRP.CFrame = hrpCF
		HRP.AssemblyLinearVelocity = linVel
		HRP.AssemblyAngularVelocity = angVel
		local torso = C.Torso
		local rj = C.RootJoint
		if torso and torso.Parent and rj and rj.Parent then
			torso.CFrame = hrpCF * rj.C0 * rj.Transform * rj.C1:Inverse()
		end
	end

	function C.UpdateCamera(FrameData, UnlockShift)
		if not C.SetCam() then return end
		local cam = workspace.CurrentCamera
		if FrameData.CamCF then
			cam.CFrame = FrameData.CamCF
		else
			cam.CFrame = C.TableToCFrame(FrameData.CamCframe)
		end
		if not UnlockShift then
			local IsShiftLock = Bridge.IsShiftlocked() and 1 or 0
			if IsShiftLock ~= FrameData.ShiftLock then Bridge.ShiftlockSwitch() end
		end
		Bridge.SetZoom(tonumber(FrameData.Zoom) or 12.5, true)
	end

	function C.anchor(value)
		if C.HRP then C.HRP.Anchored = value end
		Bridge.ShiftlockRotation(not value)
	end

	function C.LoadFrame(FrameData, unpausing, backtrack)
		local data = C.data
		if #data == 0 or not FrameData then return end
		if not FrameData.Cframe or not FrameData.State or not FrameData.Velocity then return end
		if not C.CharLoaded() then return end
		local HRP = C.HRP

		if not unpausing then
			if HRP.Anchored ~= (C.mode ~= 3) then C.anchor(C.mode ~= 3) end
			C.SyncCharacter(C.TableToCFrame(FrameData.Cframe), C.TableToVector3(FrameData.Velocity.Linear), C.TableToVector3(FrameData.Velocity.Angular))
			C.UpdateCamera(FrameData)
			if C.mode == 2 then
				ClientObjects.ShowFrame(data, C.frame)
				Buttons.ShowFrame(data, C.frame)
			end
		else
			ClientObjects.RestoreUnpause(data, C.frame)
			if C.SetCam() then Bridge.SetZoom(FrameData.Zoom, true) end
			C.LastPause = C.frame
			C.anchor(false)
		end

		HRP.AssemblyLinearVelocity = C.TableToVector3(FrameData.Velocity.Linear)
		HRP.AssemblyAngularVelocity = C.TableToVector3(FrameData.Velocity.Angular)
		pcall(function() C.Humanoid:ChangeState(FrameData.State) end)

		local BacktrackAnim, BacktrackAnimSpeed
		local AnimTime = 0
		if backtrack and C.frame > 2 then
			for i = C.frame, 1, -1 do
				local fr = data[i]
				if not fr or not fr.Anim then break end
				local anims = fr.Anim.Anims or {}
				local speed = fr.Anim.Speed or 1
				AnimTime = AnimTime + (fr.FrameTime or 0) * speed
				if #anims > 0 then
					BacktrackAnim = { anims[#anims] }
					BacktrackAnimSpeed = speed
					break
				end
			end
		end
		if not BacktrackAnimSpeed then BacktrackAnimSpeed = 1 end
		if FrameData.Anim and C.mode == 2 then
			Bridge.SetAnimation(FrameData.Anim, BacktrackAnim, (not unpausing) and 0 or BacktrackAnimSpeed, backtrack and AnimTime or nil)
		end
	end

	function C.RemoveCutFrames()
		local data = C.data
		if #data > C.frame then
			for _ = C.frame + 1, #data do data[#data] = nil end
			C.DataChanged()
		end
	end

	-- interpolated pose between two frames at playback time t (proper rotation interpolation)
	function C.AveragedFrame(f1, f2, t)
		if not f1 or not f2 or not f1.Cframe or not f2.Cframe then
			local f = f1 or f2
			if f and f.Cframe then
				return C.TableToCFrame(f.Cframe), C.TableToCFrame(f.CamCframe or f.Cframe),
					C.TableToVector3(f.Velocity.Linear), C.TableToVector3(f.Velocity.Angular), f.Zoom or 12.5
			end
			return CFrame.new(), CFrame.new(), ZERO3, ZERO3, 12.5
		end
		local t1, t2 = f1.TotalTime or 0, f2.TotalTime or 0
		local w = (t2 > t1) and clampn((t - t1) / (t2 - t1), 0, 1) or 0
		local rootCF = C.TableToCFrame(f1.Cframe):Lerp(C.TableToCFrame(f2.Cframe), w)
		local camCF = C.TableToCFrame(f1.CamCframe):Lerp(C.TableToCFrame(f2.CamCframe), w)
		local l1, l2 = f1.Velocity.Linear, f2.Velocity.Linear
		local a1, a2 = f1.Velocity.Angular, f2.Velocity.Angular
		local lin = Vector3.new(l1[1] + (l2[1] - l1[1]) * w, l1[2] + (l2[2] - l1[2]) * w, l1[3] + (l2[3] - l1[3]) * w)
		local ang = Vector3.new(a1[1] + (a2[1] - a1[1]) * w, a1[2] + (a2[2] - a1[2]) * w, a1[3] + (a2[3] - a1[3]) * w)
		local zoom = (f1.Zoom or 12.5) + ((f2.Zoom or 12.5) - (f1.Zoom or 12.5)) * w
		return rootCF, camCF, lin, ang, zoom
	end

	-- pose for the current TestingTimer, computed once and used by Heartbeat and PreRender
	function C.PlaybackPose()
		local data, frame = C.data, C.frame
		if C.poseT == C.TestingTimer and C.poseFrame == frame and C.poseData == data and C.pose then return C.pose end
		local rootCF, camCF, lin, ang, zoom = C.AveragedFrame(data[frame], data[frame + 1], C.TestingTimer)
		local p = C.pose or {}
		p.root, p.CamCF, p.lin, p.ang, p.Zoom = rootCF, camCF, lin, ang, zoom
		p.ShiftLock = data[frame] and data[frame].ShiftLock or 0
		C.pose, C.poseT, C.poseFrame, C.poseData = p, C.TestingTimer, frame, data
		return p
	end

	function C.CanCoyoteJump()
		local data, frame = C.data, C.frame
		return C.Humanoid:GetState() == Enum.HumanoidStateType.Running and data[frame] and data[frame - 1] and
			data[frame].State == Enum.HumanoidStateType.Running.Value and
			data[frame - 1].State == Enum.HumanoidStateType.Running.Value
	end

	function C.DoubleInput()
		C.CurrentFrameInput = true
		return false
	end

	function C.JumpedOffLader()
		local data, frame = C.data, C.frame
		return data[frame] and data[frame - 1] and data[frame].State == Enum.HumanoidStateType.Jumping.Value
			and data[frame - 1].State == Enum.HumanoidStateType.Climbing.Value
	end

	-- ------------------------------------------------------------------------------------ mobile
	local touchCache = { tcf = nil, t = 0 }
	local function touchFrame()
		local now = os.clock()
		if touchCache.tcf and touchCache.tcf.Parent and now - touchCache.t < 2 then return touchCache.tcf end
		touchCache.t = now
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local tg = pg and pg:FindFirstChild("TouchGui")
		touchCache.tcf = tg and tg:FindFirstChild("TouchControlFrame")
		return touchCache.tcf
	end
	C.TouchFrame = touchFrame

	function C.ReadMobile()
		local ok, res = pcall(function()
			local tcf = touchFrame()
			if not tcf then return nil end
			local jb = tcf:FindFirstChild("JumpButton")
			local M = { Jumping = (jb and jb.ImageRectOffset.X == 146) and 1 or 0 }
			local tf = tcf:FindFirstChild("ThumbstickFrame")
			local stick = tf and tf.Visible and tf:FindFirstChild("StickImage")
			if stick then
				M.JoystickX = r(stick.Position.X.Offset, 1)
				M.JoystickY = r(stick.Position.Y.Offset, 1)
			end
			local dtf = tcf:FindFirstChild("DynamicThumbstickFrame")
			if dtf and dtf.Visible then
				local sImg = dtf:FindFirstChild("ThumbstickStart")
				local eImg = dtf:FindFirstChild("ThumbstickEnd")
				if sImg and eImg and sImg.Visible then
					local mids = {}
					for _, ch in ipairs(dtf:GetChildren()) do
						if ch.Name == "ThumbstickMiddle" and ch:IsA("ImageLabel") and ch.Visible then
							local szX = ch.Size.X.Offset > 0 and ch.Size.X.Offset or ch.AbsoluteSize.X
							local szY = ch.Size.Y.Offset > 0 and ch.Size.Y.Offset or ch.AbsoluteSize.Y
							mids[#mids + 1] = { r(ch.Position.X.Offset, 1), r(ch.Position.Y.Offset, 1), r(ch.ImageTransparency, 100), r(szX, 1), r(szY, 1) }
						end
					end
					M.Dynamic = {
						Start = { r(sImg.Position.X.Offset, 1), r(sImg.Position.Y.Offset, 1), r(sImg.ImageTransparency, 100) },
						End = { r(eImg.Position.X.Offset, 1), r(eImg.Position.Y.Offset, 1), r(eImg.ImageTransparency, 100) },
						Middles = mids,
					}
				end
			end
			return M
		end)
		if ok and res then return res end
		return { Jumping = 0 }
	end

	function C.ReplayMobile(mob)
		if type(mob) ~= "table" then return end
		pcall(function()
			local tcf = touchFrame()
			if not tcf then return end
			local jb = tcf:FindFirstChild("JumpButton")
			if jb then jb.ImageRectOffset = Vector2.new((mob.Jumping or 0) * 145 + 1, 146) end
			if mob.JoystickX and mob.JoystickY then
				local tf = tcf:FindFirstChild("ThumbstickFrame")
				local stick = tf and tf:FindFirstChild("StickImage")
				if stick then stick.Position = UDim2.new(0, mob.JoystickX, 0, mob.JoystickY) end
			end
			local dtf = tcf:FindFirstChild("DynamicThumbstickFrame")
			if not dtf then return end
			local dyn = mob.Dynamic
			local sImg = dtf:FindFirstChild("ThumbstickStart")
			local eImg = dtf:FindFirstChild("ThumbstickEnd")
			local mids = {}
			for _, ch in ipairs(dtf:GetChildren()) do
				if ch.Name == "ThumbstickMiddle" and ch:IsA("ImageLabel") then mids[#mids + 1] = ch end
			end
			if dyn and dyn.Start and sImg and eImg then
				sImg.Position = UDim2.new(0, dyn.Start[1], 0, dyn.Start[2])
				sImg.ImageTransparency = dyn.Start[3]
				sImg.Visible = true
				eImg.Position = UDim2.new(0, dyn.End[1], 0, dyn.End[2])
				eImg.ImageTransparency = dyn.End[3]
				eImg.Visible = true
				local list = dyn.Middles or {}
				for i, m in ipairs(list) do
					local img = mids[i]
					if img then
						img.Position = UDim2.new(0, m[1], 0, m[2])
						img.ImageTransparency = m[3]
						if m[4] and m[5] and m[4] > 0 and m[5] > 0 then img.Size = UDim2.new(0, m[4], 0, m[5]) end
						img.Visible = true
					end
				end
				for i = #list + 1, #mids do mids[i].Visible = false end
			else
				if sImg then sImg.Visible = false end
				if eImg then eImg.Visible = false end
				for _, img in ipairs(mids) do img.Visible = false end
			end
		end)
	end
end

do
	local inputs = C.inputs
	local rs = RunService

	local function camType(t)
		pcall(function()
			local cam = workspace.CurrentCamera
			if cam and cam.CameraType ~= t then cam.CameraType = t end
		end)
	end

	-- the frame the TAS is on is held still while paused (Create)
	local function frameTime(f)
		local fr = C.data[f]
		return fr and fr.TotalTime or 0
	end

	-- --------------------------------------------------------------------------------------------- modes
	function inputs.Idle()
		Bridge.ResetGhost()
		camType(Enum.CameraType.Custom)
		C.mode, C.frame = 1, 1
		C.anchor(false)
		Bridge.LockShiftlock(false)
		Bridge.LockAnimations(false)
		Bridge.SetFreeMouse(false)
		Buttons.Release()
		ToolSync.ReplayEnd()
		Cursor.Reset()
		Bridge.RefreshMouse(Menu.IsModalOpen and Menu.IsModalOpen())
		C.guardFrames = 45
	end

	function inputs.Create(force)
		if C.DoubleInput() and not force then return end
		camType(Enum.CameraType.Custom)
		local data = C.data
		C.frame = #data
		C.mode = 2
		C.paused = true
		C.LookAround = false
		if #data > 0 and data[#data] then
			C.LoadFrame(data[#data], false, true)
			Bridge.SetZoom(data[#data].Zoom, true)
		else
			Buttons.Pause(0)
		end
		C.anchor(true)
		Bridge.LockShiftlock(false)
		Bridge.LockAnimations(true)
	end

	function inputs.Test()
		if C.DoubleInput() then return end
		local data = C.data
		if #data < 2 then task.spawn(C.SetStatus, "There is not enough TAS data to test.", true) return end
		local speed = Settings.Get("Playback Speed")
		if Settings.On("Restart When Testing") then
			C.frame = (speed > 0) and 1 or #data - 1
			C.TestingTimer = (speed > 0) and 0 or (data[#data - 1].TotalTime or 0)
			if speed > 0 and data[C.frame].Anim then
				Bridge.SetAnimation(data[C.frame].Anim, data[C.frame].Anim.Anims, speed)
			end
		else
			C.frame = clampn(C.frame, 1, #data - 1)
			C.TestingTimer = data[C.frame].TotalTime or 0
		end
		camType(Settings.On("Lock Camera (Test)") and Enum.CameraType.Scriptable or Enum.CameraType.Custom)
		C.mode = 3
		if data[C.frame] then
			C.UpdateCamera(data[C.frame], true)
			Bridge.SetZoom(data[C.frame].Zoom, true)
		end
		C.anchor(false)
		Bridge.LockShiftlock(true)
		Bridge.LockAnimations("ReplayAnimationsOnly")
		C.poseT = nil
		if speed > 0 then
			InputSys.ReplayBegin(data, C.frame)
			ClientObjects.PlaybackBegin(data, C.frame)
		end
		Buttons.PlaybackBegin(data, C.frame)
		ToolSync.ReplayBegin(data, C.frame, C.Char)
	end

	local function beginRecordingAt()
		local data = C.data
		InputSys.BeginRecording(data, C.merge and C.mergeBaseHeld or nil)
		ClientObjects.BeginRecording()
		ToolSync.Clear()
		Buttons.Resume(data, #data)
	end

	function inputs.Unpause()
		if C.DoubleInput() then return end
		local data = C.data
		if #data > 1 and C.frame > 1 and C.JumpedOffLader() then C.frame = C.frame - 1 end
		C.RemoveCutFrames()
		C.LookAround = false
		Bridge.LockAnimations(false)
		if #data > 0 then
			C.UpdateCamera(data[#data], true)
			Bridge.SetZoom(data[#data].Zoom, true)
		end
		C.LoadFrame(data[#data], true)
		C.anchor(false)
		beginRecordingAt()
		C.FirstFrameRecord = true
		C.paused = false
		Bridge.SetFreeMouse(false)
		local hum = C.Humanoid
		if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end
		rs.Heartbeat:Wait()
		rs.RenderStepped:Wait()
		if hum and hum.Parent then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
		C.FirstFrameRecord = false
		-- old camera scripts only re-lock the mouse on events: ask again now (first person fix)
		Bridge.RefreshMouse(Menu.IsModalOpen and Menu.IsModalOpen())
		C.guardFrames = 45
	end

	function inputs.Pause()
		if C.DoubleInput() then return end
		Bridge.LockAnimations(true)
		C.paused = true
		C.LoadFrame(C.data[#C.data])
		Buttons.Pause(frameTime(#C.data))
	end

	function inputs.Unpause1F()
		if C.DoubleInput() then return end
		local data = C.data
		local FrameCount = 1
		if #data > 1 and C.frame > 1 and C.JumpedOffLader() then C.frame = C.frame - 1; FrameCount = 2 end
		if #data > 1 and data[C.frame] and data[C.frame].State == Enum.HumanoidStateType.Landed.Value then FrameCount = 2 end
		C.RemoveCutFrames()
		C.LookAround = false
		Bridge.LockAnimations(false)
		if #data > 0 then
			C.UpdateCamera(data[#data], true)
			Bridge.SetZoom(data[#data].Zoom, true)
		end
		C.anchor(false)
		beginRecordingAt()
		C.FirstFrameRecord = true
		C.LoadFrame(data[#data], true)
		local hum = C.Humanoid
		if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end
		rs.Heartbeat:Wait()
		rs.RenderStepped:Wait()
		if hum and hum.Parent then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
		C.paused = false
		C.FirstFrameRecord = false
		for _ = 1, FrameCount do rs.RenderStepped:Wait() end
		Bridge.LockAnimations(true)
		C.paused = true
		C.LoadFrame(C.data[#C.data], false, true)
		Buttons.Pause(frameTime(#C.data))
	end

	function inputs.Return()
		if C.DoubleInput() then return end
		C.frame = C.LastPause
		C.RemoveCutFrames()
		C.paused = true
		Bridge.LockAnimations(true)
		C.LoadFrame(C.data[C.frame], false, true)
	end

	function inputs.Back1F()
		if C.DoubleInput() then return end
		C.frame = C.frame - 1
		C.paused = true
		Bridge.LockAnimations(true)
		C.LoadFrame(C.data[C.frame], false, true)
	end

	function inputs.Forward1F()
		if C.DoubleInput() then return end
		C.frame = C.frame + 1
		C.paused = true
		Bridge.LockAnimations(true)
		C.LoadFrame(C.data[C.frame], false, true)
	end

	function inputs.Back()
		if C.DoubleInput() then return end
		C.back, C.paused = true, true
		Bridge.LockAnimations(true)
		C.LoadFrame(C.data[C.frame], false, true)
	end

	function inputs.Forward()
		if C.DoubleInput() then return end
		C.forw, C.paused = true, true
		Bridge.LockAnimations(true)
		C.LoadFrame(C.data[C.frame], false, true)
	end

	local ConfirmDelete, ConfirmOptimize = false, false
	function inputs.Delete(mobile)
		if ConfirmDelete then
			C.data = {}
			C.DataChanged()
			C.LastPause = 1
			C.frame = 0
			task.spawn(C.SetStatus, "TAS Deleted")
			ConfirmDelete = false
		else
			ConfirmDelete = true
			C.SetStatus(mobile and "Delete TAS? Click To Confirm" or "Delete TAS? [" .. tostring(Controls.Get("Delete TAS")) .. "] To Confirm")
			ConfirmDelete = false
		end
	end

	function inputs.Optimize(mobile)
		if C.mode ~= 1 then
			task.spawn(C.SetStatus, "Switch to idle to optimize TAS")
			return
		end
		if ConfirmOptimize then
			ConfirmOptimize = false
			local data = C.data
			local NewData = {}
			local prev, prevMX, prevMY
			-- frame 1 is always kept: it holds the starting pose and the client object / button snapshots
			for i = 1, #data do
				local v = data[i]
				local values = v.CamCframe
				local SameCount = 0
				local mouseMoved = v.MX ~= nil and (v.MX ~= prevMX or v.MY ~= prevMY)
				prevMX, prevMY = v.MX, v.MY
				if prev then
					for y, z in pairs(values) do
						if prev[y] == z then SameCount = SameCount + 1 end
					end
				end
				prev = values
				if i == 1 or SameCount < 12 or (v.Anim and v.Anim.Anims and #v.Anim.Anims > 0) or (v.Input and #v.Input > 0) or mouseMoved
					or v.CO ~= nil or v.BT ~= nil or v.Tools ~= nil or v.Died then
					NewData[#NewData + 1] = v
					if #NewData > 1 then
						v.TotalTime = r(NewData[#NewData - 1].TotalTime + v.FrameTime, 1000000)
					else
						v.TotalTime = r(v.FrameTime, 1000000)
					end
				end
			end
			C.data = NewData
			C.DataChanged()
			task.spawn(C.SetStatus, "TAS Optimized")
		else
			ConfirmOptimize = true
			C.SetStatus(mobile and "Optimize TAS? Click To Confirm" or "Optimize TAS? [" .. tostring(Controls.Get("Optimize TAS")) .. "] To Confirm")
			ConfirmOptimize = false
		end
	end

	function inputs.LookAround()
		C.LookAround = not C.LookAround
		C.guardFrames = 45
	end

	-- --------------------------------------------------------------------------------------------- merge
	function C.DestroyMergeHitboxes()
		for _, hitbox in ipairs(C.hitboxes) do pcall(function() hitbox:Destroy() end) end
		C.hitboxes = {}
	end

	function C.CreateMergeHitboxes()
		C.DestroyMergeHitboxes()
		local mb, ma = C.mergeBefore, C.mergeAfter
		if not mb or #mb == 0 or not ma or #ma == 0 or not mb[#mb].Cframe or not ma[1].Cframe then return end
		for _, hitboxName in ipairs({ "startHitbox", "endHitbox" }) do
			local hitbox = Instance.new("Part")
			hitbox.Name = hitboxName
			local cfTable = (hitboxName == "startHitbox") and mb[#mb].Cframe or ma[1].Cframe
			hitbox.CFrame = C.TableToCFrame(cfTable)
			hitbox.Anchored = true
			hitbox.Color = (hitboxName == "startHitbox") and Color3.fromRGB(205, 10, 0) or Color3.fromRGB(0, 185, 8)
			hitbox.Transparency = 0.5
			hitbox.CanCollide, hitbox.CanQuery, hitbox.CanTouch = false, false, false
			hitbox.Size = Vector3.new(2.1, 2.1, 1.1)
			hitbox.TopSurface = Enum.SurfaceType.Smooth
			hitbox.Parent = workspace.CurrentCamera or workspace
			C.hitboxes[#C.hitboxes + 1] = hitbox
		end
	end

	-- --------------------------------------------------------------------------------------------- public
	function Core.GetTAS(length) return length and #C.data or C.data end

	function Core.SetTAS(LoadedTAS, whenMerge)
		if whenMerge then
			C.oldTAS = C.data
			if whenMerge == "after" then C.mergeBefore = C.data; C.mergeAfter = LoadedTAS
			else C.mergeBefore = LoadedTAS; C.mergeAfter = C.data end
			local mb, ma = C.mergeBefore, C.mergeAfter
			if not mb or #mb == 0 or not ma or #ma == 0 then
				task.spawn(C.SetStatus, "Cannot merge: one of the TAS runs is empty", true)
				C.merge = false
				return
			end
			if not mb[#mb].Cframe or not ma[1].Cframe then
				task.spawn(C.SetStatus, "Cannot merge: missing frame data", true)
				C.merge = false
				return
			end
			C.data = { mb[#mb] }
			C.DataChanged()
			C.mergeBaseHeld = InputSys.HeldAt(mb, #mb - 1)
			C.merge = true
			inputs.Create()
			C.CreateMergeHitboxes()
			local t1 = mb[#mb].FrameTime or 0.016
			local t2 = ma[1].FrameTime or 0.016
			C.mergeReqDist = 16 * (t1 + t2) / 2
			C.mergeCFrame = ma[1].Cframe
		else
			C.data = LoadedTAS or {}
			C.DataChanged()
			if C.mode == 2 then
				C.frame = #C.data
				if #C.data > 0 then
					C.LoadFrame(C.data[#C.data])
					if C.data[#C.data].Zoom then Bridge.SetZoom(C.data[#C.data].Zoom, true) end
				end
			end
		end
	end

	function Core.GetMode() return C.mode end
	function Core.GetFrame() return C.frame end
	function Core.IsPaused() return C.paused end
	function Core.IsMerging() return C.merge end
	function Core.DataVersion() return C.dataVersion end

	function Core.Shutdown()
		pcall(function()
			if C.HRP and C.HRP.Parent and C.mode ~= 1 then inputs.Idle() end
			if C.HRP and C.HRP.Parent then C.HRP.Anchored = false end
		end)
		pcall(C.DestroyMergeHitboxes)
		pcall(InputSys.ReplayEnd)
		pcall(ClientObjects.EndPlayback)
		pcall(Buttons.Release)
		pcall(Bridge.LockShiftlock, false)
		pcall(Bridge.LockAnimations, false)
		pcall(Bridge.SetFreeMouse, false)
	end

	function Core.CharLoad(char)
		local hum = char:WaitForChild("Humanoid", 30)
		local root = char:WaitForChild("HumanoidRootPart", 30)
		if not hum or not root or Janitor.unloading then return end
		C.Humanoid, C.HRP, C.Char = hum, root, char
		C.Torso = char:FindFirstChild("Torso")
		C.RootJoint = root:FindFirstChild("RootJoint")
		on(hum.Died, function()
			if Settings.On("Record Death & Respawn") then return end -- the recording / replay keeps going
			if C.mode == 2 and not C.paused and #C.data > 0 then
				C.data[#C.data] = nil
				C.DataChanged()
			end
			if C.mode ~= 1 then inputs.Idle() end
		end)
	end
end

do
	local inputs = C.inputs
	local rs = RunService
	local uis = UIS
	local RENDER_BIND = "HappaTASLate"

	local function finishTest()
		Bridge.ResetGhost()
		pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
		InputSys.ReplayEnd()
		ClientObjects.EndPlayback()
		Buttons.Release()
		ToolSync.ReplayEnd()
		C.mode, C.frame = 1, 1
		Bridge.LockShiftlock(false)
		Bridge.LockAnimations(false)
		Bridge.SetFreeMouse(false)
		Bridge.RefreshMouse(Menu.IsModalOpen and Menu.IsModalOpen())
		C.guardFrames = 45
		Cursor.Reset()
		local data = C.data
		if not C.QuitTestEvent and #data > 0 and data[#data] and data[#data].TotalTime and Settings.On("Show Completion Message") then
			task.spawn(C.SetStatus, "TAS Completed [Time: " .. C.ToTime(data[#data].TotalTime) .. "]")
		end
		if uis.TouchEnabled and C.MobileUI then
			for _, v in pairs(C.MobileUI.MobileModes:GetChildren()) do v.Visible = true end
			C.MobileUI.MenuOpener.Visible = true
			C.MobileUI.More.Visible = true
		end
		if C.QuitTestEvent then C.QuitTestEvent:Disconnect(); C.QuitTestEvent = nil end
	end

	local function menuOpen()
		return Menu.IsModalOpen ~= nil and Menu.IsModalOpen()
	end

	-- mouse lock rules: free while paused with a locked camera / testing with a scriptable camera.
	-- For a short time after HappaTAS hands the camera back, the camera's mouse lock is checked
	-- every frame (stale first person state from older camera scripts), never longer.
	local function updateMouseMode()
		local free = false
		if C.mode == 2 and C.paused and C.SetCam() and not C.LookAround then free = true end
		if C.mode == 3 and Settings.On("Lock Camera (Test)") then free = true end
		Bridge.SetFreeMouse(free)
		if C.guardFrames > 0 then
			C.guardFrames = C.guardFrames - 1
			if not free and C.mode ~= 3 then Bridge.GuardMouse(menuOpen()) end
		end
	end

	-- ---------------------------------------------------------------------------------------- PreRender
	local function preRender(dt)
		Profiler.FrameBegin(dt)
		Profiler.Begin("HappaTAS")
		local data, mode = C.data, C.mode
		if not (mode == 2 and not C.paused) then InputSys.Clear() end

		if mode == 2 and C.CharLoaded() then
			if not C.paused and C.NotDead() and not C.FirstFrameRecord then
				Profiler.Begin("Record")
				local HRP = C.HRP
				local n = #data
				local ft = r(C.LastFrameTime, 1000000)
				local total = (n >= 2 and data[n].TotalTime) and r(data[n].TotalTime + C.LastFrameTime, 1000000) or ft
				local mx, my, uvx, uvy, vx, vy = InputSys.Mouse()
				data[n + 1] = {
					Cframe = nil,
					Velocity = { Linear = C.Vector3ToTable(HRP.AssemblyLinearVelocity), Angular = C.Vector3ToTable(HRP.AssemblyAngularVelocity) },
					State = nil,
					CamCframe = C.CFrameToTable(workspace.CurrentCamera.CFrame),
					ShiftLock = Bridge.IsShiftlocked() and 1 or 0,
					Mobile = C.IsMobile and C.ReadMobile() or 0,
					Anim = nil,
					Zoom = r(Bridge.GetZoom(), 1000),
					FrameTime = ft,
					TotalTime = total,
					Input = InputSys.Take(),
					MX = mx, MY = my, UVX = uvx, UVY = uvy, VX = vx, VY = vy,
				}
				Profiler.End("Record")
			end
			if C.paused and #data > 1 and not C.LookAround and data[C.frame] then
				C.UpdateCamera(data[C.frame], true)
			end
		elseif mode == 3 and C.CharLoaded() and data[C.frame + 1] and C.TestingTimer >= 0 then
			Profiler.Begin("Playback")
			local p = C.PlaybackPose()
			C.SyncCharacter(p.root, p.lin, p.ang)
			C.UpdateCamera(p)
			if C.SetCam() and workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
				Bridge.UpdateGhost(p.Zoom, dt)
			end
			Profiler.End("Playback")
		end
		Profiler.End("HappaTAS")
	end

	-- ---------------------------------------------------------------------------------------- PreSimulation
	local function preSimulation()
		Profiler.Begin("HappaTAS")
		local data = C.data
		if C.mode == 2 and C.CharLoaded() and not C.paused and not C.FirstFrameRecord and C.NotDead() then
			local fd = data[#data]
			if fd and fd.Cframe == nil then
				Profiler.Begin("Record")
				local HRP, hum = C.HRP, C.Humanoid
				fd.Cframe = C.CFrameToTable(HRP.CFrame)
				fd.State = hum:GetState().Value
				fd.Anim = Bridge.GetAnimation(#data == 2)
				Profiler.End("Record")
				Profiler.Begin("Client Objects")
				fd.CO = ClientObjects.Record(HRP.Position, fd.TotalTime)
				Profiler.End("Client Objects")
				fd.Tools = ToolSync.Take()
				Profiler.Begin("Buttons")
				fd.BT = Buttons.RecordFrame(fd.TotalTime, #data == 1)
				Profiler.End("Buttons")
				if hum:GetState() == Enum.HumanoidStateType.Dead or hum.Health <= 0 then fd.Died = true end
			end
		elseif C.mode == 3 and C.CharLoaded() and data[C.frame + 1] and C.TestingTimer >= 0 then
			C.Humanoid:Move(C.HRP.AssemblyLinearVelocity)
		end
		Profiler.End("HappaTAS")
	end

	-- ---------------------------------------------------------------------------------------- Heartbeat
	local function playbackStep(dt)
		local data = C.data
		local speed = Settings.Get("Playback Speed")
		C.TestingTimer = C.TestingTimer + C.LastFrameTime * speed

		if Settings.On("Interpolate Playback") then
			local prevFrame = C.frame
			while data[C.frame + 1] and C.TestingTimer > (data[C.frame + 1].TotalTime or 0) do C.frame = C.frame + 1 end
			while C.frame > 1 and data[C.frame - 1] and C.TestingTimer < (data[C.frame - 1].TotalTime or 0) do C.frame = C.frame - 1 end
			local frame = C.frame
			if frame > 0 then InputSys.ReplayTo(data, frame) end
			if not data[frame + 1] or frame == 0 or not data[frame] then return end
			InputSys.ReplayMouse(data[frame])
			Profiler.Begin("Client Objects")
			ClientObjects.PlaybackTo(data, frame, C.TestingTimer)
			Profiler.End("Client Objects")
			Profiler.Begin("Buttons")
			Buttons.PlaybackTo(data, frame, C.TestingTimer)
			Profiler.End("Buttons")

			if data[frame + 1].FrameTime and data[frame + 1].FrameTime > 0.1 then
				-- a lag spike was recorded here: hold the frame instead of sliding through it
				local fr = data[frame]
				if fr.Cframe and fr.Velocity then
					C.SyncCharacter(C.TableToCFrame(fr.Cframe), C.TableToVector3(fr.Velocity.Linear), C.TableToVector3(fr.Velocity.Angular))
				end
				C.UpdateCamera(fr)
				if fr.Anim and fr.Anim.Anims then Bridge.SetAnimation(fr.Anim, fr.Anim.Anims, 0) end
				return
			end

			local p = C.PlaybackPose()
			C.SyncCharacter(p.root, p.lin, p.ang)
			if data[frame].State then pcall(function() C.Humanoid:ChangeState(data[frame].State) end) end
			C.UpdateCamera(p)
			local lo, hi = prevFrame + 1, frame
			if lo > hi then lo, hi = frame, frame end
			for f = lo, hi do
				local fr = data[f]
				if fr and f > prevFrame then
					if fr.Anim and fr.Anim.Anims then
						Bridge.SetAnimation(fr.Anim, { fr.Anim.Anims[#fr.Anim.Anims] }, speed)
					end
					if fr.Tools then ToolSync.ReplayFrame(fr.Tools, C.Char) end
				end
			end
			if data[frame].Died then pcall(function() C.Humanoid:ChangeState(Enum.HumanoidStateType.Dead) end) end
			ToolSync.Step(C.Char, C.Humanoid)
			C.SetStats("Test")
		else
			C.frame = C.frame + 1
			local frame = C.frame
			local fr = data[frame]
			if not fr then return end
			InputSys.ReplayTo(data, frame)
			InputSys.ReplayMouse(fr)
			ClientObjects.PlaybackTo(data, frame, nil)
			Buttons.PlaybackTo(data, frame, fr.TotalTime)
			local FrameTime = fr.FrameTime or 0
			if C.FreezeTimeRemaining > dt then
				if fr.Cframe and fr.Velocity then
					C.SyncCharacter(C.TableToCFrame(fr.Cframe), C.TableToVector3(fr.Velocity.Linear), C.TableToVector3(fr.Velocity.Angular))
				end
				C.UpdateCamera(fr)
				if fr.Anim and fr.Anim.Anims then Bridge.SetAnimation(fr.Anim, fr.Anim.Anims, 0) end
				C.FreezeTimeRemaining = C.FreezeTimeRemaining - dt
				return
			end
			if FrameTime > 2 * dt then
				C.FreezeTimeRemaining = FrameTime - dt
				return
			end
			C.LoadFrame(fr)
			if fr.Anim and fr.Anim.Anims then Bridge.SetAnimation(fr.Anim, fr.Anim.Anims, speed) end
			if fr.Tools then ToolSync.ReplayFrame(fr.Tools, C.Char) end
			ToolSync.Step(C.Char, C.Humanoid)
			C.SetStats("Test")
		end

		local fr = data[C.frame]
		if fr and type(fr.Mobile) == "table" and uis.TouchEnabled then C.ReplayMobile(fr.Mobile) end
	end

	local function heartbeat(dt)
		Profiler.Heartbeat()
		Profiler.Begin("HappaTAS")
		local mode, data = C.mode, C.data
		if mode ~= 3 and InputSys.IsReplaying() then InputSys.ReplayEnd() end
		if mode ~= 3 and ClientObjects.IsTesting() then ClientObjects.EndPlayback() end
		if mode == 1 and ClientObjects.IsHolding() then ClientObjects.Release() end

		if C.CharLoaded() then
			if mode == 1 then
				C.SetStats("Idle", nil, dt)
			elseif mode == 2 then
				if C.paused then
					ClientObjects.Tick()
					if #data > 1 and C.back and C.frame > 1 then
						C.frame = C.frame - 1
						if data[C.frame] then C.LoadFrame(data[C.frame], false, true) end
					end
					if C.frame < #data and C.forw then
						C.frame = C.frame + 1
						if data[C.frame] then C.LoadFrame(data[C.frame], false, true) end
					end
					Buttons.Step(data[C.frame] and data[C.frame].TotalTime or 0)
				else
					if C.FirstFrameRecord and #data == 1 then
						data[1].FrameTime = r(C.LastFrameTime, 1000000)
						data[1].TotalTime = r(C.LastFrameTime, 1000000)
					end
					if #data > 0 and data[#data].Cframe == nil then data[#data] = nil end
					C.frame = #data
					Buttons.Step(data[#data] and data[#data].TotalTime or 0)
				end
				C.SetStats("Create", data[C.frame], dt, C.frame)
			elseif mode == 3 and data[C.frame + 1] and C.TestingTimer >= 0 then
				Profiler.Begin("Playback")
				playbackStep(dt)
				Profiler.End("Playback")
			elseif mode == 3 then
				finishTest()
			end
		end
		C.LastFrameTime = dt

		if C.CurrentFrameInput then
			C.InputDebounce = C.InputDebounce + 1
			if C.InputDebounce == 3 then C.InputDebounce = 0; C.CurrentFrameInput = false end
		end
		Profiler.End("HappaTAS")
	end

	-- ---------------------------------------------------------------------------------------- end of render step
	local function lateRender()
		Profiler.Begin("HappaTAS")
		ClientObjects.RenderStep()
		updateMouseMode()
		Profiler.Begin("Cursor")
		Cursor.Update(C.mode, (C.mode == 3) and C.data[C.frame] or nil, menuOpen())
		Profiler.End("Cursor")
		Profiler.End("HappaTAS")
	end

	-- ---------------------------------------------------------------------------------------- start
	function Core.Start(gui)
		C.Gui = gui
		C.MobileUI = gui.Mobile
		C.MergeStats = gui.MergeStats
		C.IdleStatsF = gui.IdleStats
		C.CreateStatsF = gui.CreateStats
		C.TestStatsF = gui.TestStats
		local MobileUI = C.MobileUI

		on(rs.PreRender, function(dt)
			local ok, err = pcall(preRender, dt)
			if not ok then log("PreRender:", tostring(err)) end
		end)
		on(rs.PreSimulation, function()
			local ok, err = pcall(preSimulation)
			if not ok then log("PreSimulation:", tostring(err)) end
		end)
		on(rs.Heartbeat, function(dt)
			local ok, err = pcall(heartbeat, dt)
			if not ok then log("Heartbeat:", tostring(err)) end
		end)
		pcall(function()
			rs:BindToRenderStep(RENDER_BIND, Enum.RenderPriority.Last.Value + 1, function()
				local ok, err = pcall(lateRender)
				if not ok then log("render step:", tostring(err)) end
			end)
		end)
		Janitor.add(function() pcall(function() rs:UnbindFromRenderStep(RENDER_BIND) end) end)

		-- MicroProfiler: TAS timeline data + scrubbing (Create while paused, or Test)
		Profiler.GetTAS = function() return C.data, C.frame, C.dataVersion end
		Profiler.OnScrub = function(target)
			local data = C.data
			target = clampn(math.floor(target), 1, math.max(1, #data))
			if C.mode == 2 and C.paused and data[target] then
				C.frame = target
				C.LoadFrame(data[target], false, true)
			elseif C.mode == 3 and data[target] and data[target + 1] then
				C.frame = target
				C.TestingTimer = data[target].TotalTime or 0
				InputSys.ReplayTo(data, target)
				C.poseT = nil
			end
		end

		on(uis.JumpRequest, function()
			if C.Humanoid and C.mode == 2 and C.frame > 1 and C.CanCoyoteJump() then
				C.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)

		on(uis.InputBegan, function(inp, proc)
			if CheckInput(inp, "MicroProfiler") and not (proc and inp.UserInputType == Enum.UserInputType.Keyboard and uis:GetFocusedTextBox()) then
				Settings.Set("Show MicroProfiler", Settings.On("Show MicroProfiler") and 0 or 1)
				return
			end
			if inp.KeyCode == Enum.KeyCode.P and Profiler.active and (uis:IsKeyDown(Enum.KeyCode.LeftControl) or uis:IsKeyDown(Enum.KeyCode.RightControl)) then
				Profiler.TogglePause()
				return
			end
			if proc and not Settings.On("Ignore Game Processed") then return end
			if uis:GetFocusedTextBox() then return end
			if not C.Humanoid then return end
			local mode, paused, data, merge = C.mode, C.paused, C.data, C.merge
			if CheckInput(inp, "Idle") and not merge then inputs.Idle()
			elseif CheckInput(inp, "Create") and not merge then inputs.Create()
			elseif CheckInput(inp, "Test") and #data > 0 and not merge then inputs.Test()
			elseif CheckInput(inp, "Unpause") and mode == 2 and paused then inputs.Unpause()
			elseif CheckInput(inp, "Pause") and mode == 2 and not paused then inputs.Pause()
			elseif CheckInput(inp, "Unpause 1 Frame") and mode == 2 and paused then inputs.Unpause1F()
			elseif CheckInput(inp, "Return") and mode == 2 and #data > 0 then inputs.Return()
			elseif CheckInput(inp, "Back 1 Frame") and mode == 2 and #data > 1 and C.frame > 1 then inputs.Back1F()
			elseif CheckInput(inp, "Forward 1 Frame") and mode == 2 and C.frame < #data then inputs.Forward1F()
			elseif CheckInput(inp, "Back") and mode == 2 then inputs.Back()
			elseif CheckInput(inp, "Forward") and mode == 2 then inputs.Forward()
			elseif CheckInput(inp, "Delete TAS") and not merge then inputs.Delete()
			elseif CheckInput(inp, "Optimize TAS") then inputs.Optimize()
			elseif CheckInput(inp, "Look Around") and mode == 2 and paused and Settings.On("Lock Camera (Paused)") then inputs.LookAround() end
		end)

		on(uis.InputEnded, function(inp)
			if CheckInput(inp, "Back") then C.back = false end
			if CheckInput(inp, "Forward") then C.forw = false end
		end)

		-- mobile buttons
		local function SetPauseButton(pausedNow)
			local icon = MobileUI.MobileCreate.Pause.Icon
			if pausedNow then
				icon.Image = "rbxassetid://10392248278"
				icon.Size = UDim2.new(0.285, 0, 0.7, 0)
				icon.Position = UDim2.new(0.357, 0, 0.132, 0)
			else
				icon.Image = "rbxassetid://4458862490"
				icon.Size = UDim2.new(0.471, 0, 1, 0)
				icon.Position = UDim2.new(0.262, 0, 0, 0)
			end
		end
		local function ShowCreateButtons(visible)
			for _, b in pairs(MobileUI.MobileCreate:GetChildren()) do b.Visible = visible end
		end
		on(MobileUI.MobileModes.Mode1Mobile.MouseButton1Click, function() inputs.Idle(); ShowCreateButtons(false) end)
		on(MobileUI.MobileModes.Mode2Mobile.MouseButton1Click, function() inputs.Create(); ShowCreateButtons(true); SetPauseButton(true) end)
		on(MobileUI.MobileModes.Mode3Mobile.MouseButton1Click, function()
			if #C.data < 1 then return end
			inputs.Test()
			for _, v in pairs(MobileUI:GetChildren()) do
				if v:IsA("Folder") then
					for _, z in pairs(v:GetChildren()) do z.Visible = false end
				else v.Visible = false end
			end
			task.wait(0.1)
			local ConfirmQuit = false
			if C.QuitTestEvent then C.QuitTestEvent:Disconnect() end
			C.QuitTestEvent = uis.TouchTap:Connect(function()
				if ConfirmQuit then C.frame = #C.data; task.spawn(C.SetStatus, "Test Quit")
				else ConfirmQuit = true; C.SetStatus("Tap Again to Quit Test"); ConfirmQuit = false end
			end)
			Janitor.add(C.QuitTestEvent)
		end)
		on(MobileUI.MobileCreate.Pause.MouseButton1Click, function()
			if C.paused then inputs.Unpause(); SetPauseButton(false) else inputs.Pause(); SetPauseButton(true) end
		end)
		on(MobileUI.MobileCreate.Unpause1Frame.MouseButton1Click, function() if C.paused then inputs.Unpause1F() end end)
		on(MobileUI.MobileCreate.Return.MouseButton1Click, function() if #C.data > 0 then inputs.Return(); SetPauseButton(true) end end)
		on(MobileUI.MobileCreate.Back1Frame.MouseButton1Click, function() if #C.data > 1 and C.frame > 1 then inputs.Back1F(); SetPauseButton(true) end end)
		on(MobileUI.MobileCreate.Forward1Frame.MouseButton1Click, function() if C.frame < #C.data then inputs.Forward1F(); SetPauseButton(true) end end)
		on(MobileUI.MobileCreate.Back.MouseButton1Down, function() inputs.Back(); SetPauseButton(true) end)
		on(MobileUI.MobileCreate.Forward.MouseButton1Down, function() inputs.Forward(); SetPauseButton(true) end)
		on(MobileUI.MobileCreate.Back.MouseButton1Up, function() C.back = false end)
		on(MobileUI.MobileCreate.Forward.MouseButton1Up, function() C.forw = false end)
		on(MobileUI.MobileOptions.Delete.MouseButton1Click, function() inputs.Delete(true) end)
		on(MobileUI.MobileOptions.Optimize.MouseButton1Click, function() inputs.Optimize(true) end)
		on(MobileUI.MobileCreate.LookAround.MouseButton1Click, function()
			if C.paused and Settings.On("Lock Camera (Paused)") then inputs.LookAround() end
		end)

		on(C.MergeStats.MouseButton1Click, function()
			if C.mergeCanComplete then
				C.merge = false
				inputs.Idle()
				C.DestroyMergeHitboxes()
				local newData = {}
				local mb, ma = C.mergeBefore, C.mergeAfter
				local beginRetiming = #mb
				table.move(mb, 1, #mb, 1, newData)
				table.move(C.data, 2, #C.data, #newData + 1, newData)
				table.move(ma, 1, #ma, #newData + 1, newData)
				for i = math.max(2, beginRetiming), #newData do
					newData[i].TotalTime = r(newData[i].FrameTime + newData[i - 1].TotalTime, 1000000)
				end
				C.oldTAS, C.mergeBefore, C.mergeAfter, C.mergeBaseHeld = {}, {}, {}, nil
				C.data = newData
				C.DataChanged()
				task.spawn(C.SetStatus, "Merge Complete")
			else
				C.merge = false
				inputs.Idle()
				C.DestroyMergeHitboxes()
				C.data = C.oldTAS
				C.DataChanged()
				C.oldTAS, C.mergeBefore, C.mergeAfter, C.mergeBaseHeld = {}, {}, {}, nil
				task.spawn(C.SetStatus, "Merge Cancelled")
			end
		end)

		Settings.Changed("Lock Camera (Paused)", function()
			if C.mode == 2 and C.paused and C.data[C.frame] then C.LoadFrame(C.data[C.frame]) end
		end)
	end
end

-- ================================================================================================
--  MENU  (Controls, Settings, Saves, Help, More)
-- ================================================================================================
do
	local uis = UIS
	local ts = TweenService

	local Gui, menu, MobileUI, MergeMenu, JoinMessage
	local ControlsFrame, SettingsFrame, SavesFrame, HelpFrame, MoreFrame
	local WaitInputConnection, ChangingInput = nil, nil
	local SavingOrLoading = false
	local slotFrames = {}
	local slotNameOf = {}
	local pendingMerge = nil

	function Menu.IsModalOpen()
		return (menu ~= nil and menu.Visible) or (MergeMenu ~= nil and MergeMenu.Visible)
	end

	local function SetStatus(text, fade)
		task.spawn(C.SetStatus, text, fade)
	end
	Menu.SetStatus = SetStatus

	local function autoCanvas(scroller, container, extra)
		local layout = container:FindFirstChildOfClass("UIListLayout")
		if not layout then return end
		local function fit()
			if container.Name == "List" or container.Name == "YourSlots" then
				container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, 0, layout.AbsoluteContentSize.Y)
			end
			scroller.CanvasSize = UDim2.new(0, 0, 0, container.Position.Y.Offset + layout.AbsoluteContentSize.Y + (extra or 30))
		end
		on(layout:GetPropertyChangedSignal("AbsoluteContentSize"), fit)
		fit()
	end

	local function SetStatsSize(TextSize)
		for _, v in ipairs({ Gui.IdleStats, Gui.CreateStats, Gui.TestStats, Gui.MergeStats }) do
			local rows = 0
			for _, x in ipairs(v:GetChildren()) do
				if x:IsA("TextLabel") then
					rows = rows + 1
					x.Size = UDim2.new(1, 0, 0, 18 * TextSize / 11)
					x.TextSize = TextSize
				end
			end
			v.Size = UDim2.new(0, 240 * TextSize / 11, 0, rows * 18 * TextSize / 11)
			if v.Name == "MergeStats" then
				v.Position = UDim2.new(1, -10, 1, -180 * TextSize / 11 - 20)
			end
		end
	end

	local function progressText(verb)
		return function(i, n) task.spawn(C.SetStatus, verb .. " " .. i .. "/" .. n, true) end
	end

	local function sizeText(size)
		if not size then return "?" end
		if size >= 1048576 then return string.format("%.2f MB", size / 1048576) end
		return string.format("%.1f KB", size / 1024)
	end

	local function SaveSlot(name)
		if not name then return end
		if SavingOrLoading then SetStatus("You are already saving or loading.", true) return end
		local source = Core.GetTAS()
		if #source == 0 then SetStatus("There is nothing to save", true) return end
		SavingOrLoading = true
		local copy = table.move(source, 1, #source, 1, {})
		SetStatus("Saving...", true)
		local ok, res, size = Store.SaveSlot(name, copy, progressText("Saving"))
		SavingOrLoading = false
		if ok then
			SetStatus("Save Success! (" .. res .. " frames, " .. sizeText(size) .. ")", true)
		else
			SetStatus("Save Failed: " .. tostring(res), true)
		end
	end

	local function LoadSlot(name, mergeWhen)
		if not name then return end
		if SavingOrLoading then SetStatus("You are already saving or loading.", true) return end
		SavingOrLoading = true
		SetStatus("Loading...", true)
		local ok, result = Store.LoadSlot(name, progressText("Loading"))
		SavingOrLoading = false
		if ok then
			if #result == 0 then SetStatus("There is nothing to load", true) return end
			Core.SetTAS(result, mergeWhen)
			SetStatus(mergeWhen and "Move into the green hitbox to complete the merge" or "Load Success!", true)
		else
			SetStatus("Load Failed: " .. tostring(result), true)
		end
	end

	local function MergeSlot(name)
		if not name then return end
		if Core.GetTAS(true) == 0 then SetStatus("You must have a TAS to merge", true) return end
		if SavingOrLoading then SetStatus("You are already saving or loading.", true) return end
		SavingOrLoading = true
		SetStatus("Loading...", true)
		local ok, result = Store.LoadSlot(name, progressText("Loading"))
		SavingOrLoading = false
		if not ok or type(result) ~= "table" or #result == 0 then SetStatus("Load Failed: " .. tostring(result), true) return end
		local running = Enum.HumanoidStateType.Running.Value
		local canBefore = result[#result].State == running
		local canAfter = result[1].State == running
		pendingMerge = result
		SetStatus("")
		menu.Visible = false
		MergeMenu.Visible = true
		MergeMenu.Options.Before.Interactable = canBefore
		MergeMenu.Options.Before.BackgroundColor3 = canBefore and Color3.fromRGB(0, 52, 129) or Color3.fromRGB(50, 50, 50)
		MergeMenu.Options.After.Interactable = canAfter
		MergeMenu.Options.After.BackgroundColor3 = canAfter and Color3.fromRGB(0, 52, 129) or Color3.fromRGB(50, 50, 50)
	end

	local function updateSlotCount()
		local n = 0
		for _ in pairs(slotFrames) do n = n + 1 end
		SavesFrame.YourSlots.Top.Count.Text = n .. (n == 1 and " slot" or " slots")
	end

	local function reorderSlots(names)
		names = names or Store.ListSlots()
		for i, name in ipairs(names) do
			local f = slotFrames[name]
			if f then f.LayoutOrder = i; f.IDtext.Text = "#" .. i end
		end
	end

	local function createSlotFrame(name)
		local Slot = UI.Template("Slot")
		Slot.Name = "Slot_" .. name
		Slot.N.Text = name
		slotFrames[name] = Slot
		slotNameOf[Slot] = name
		Slot.Parent = SavesFrame.YourSlots

		on(Slot.N.FocusLost, function()
			local old = slotNameOf[Slot]
			if not old then return end
			local clean = Store.CleanName(Slot.N.Text)
			if not clean or clean == old then Slot.N.Text = old return end
			local ok, res = Store.RenameSlot(old, clean)
			if ok then
				slotFrames[old] = nil
				slotFrames[res] = Slot
				slotNameOf[Slot] = res
				Slot.Name = "Slot_" .. res
				Slot.N.Text = res
				reorderSlots()
			else
				Slot.N.Text = old
				SetStatus(tostring(res), true)
			end
		end)

		local confirmDelete = false
		on(Slot.MoreButtons.Delete.MouseButton1Click, function()
			local nm = slotNameOf[Slot]
			if not nm then return end
			if not confirmDelete then
				confirmDelete = true
				Slot.MoreButtons.Delete.Text = "Sure?"
				task.delay(3, function() confirmDelete = false; if Slot.Parent then Slot.MoreButtons.Delete.Text = "Delete" end end)
				return
			end
			local ok, err = Store.DeleteSlot(nm)
			if ok then
				slotFrames[nm] = nil
				slotNameOf[Slot] = nil
				Slot:Destroy()
				updateSlotCount()
				reorderSlots()
			else
				SetStatus("Delete failed: " .. tostring(err), true)
			end
		end)

		on(Slot.Buttons.Save.MouseButton1Click, function() SaveSlot(slotNameOf[Slot]) end)
		on(Slot.Buttons.Load.MouseButton1Click, function() LoadSlot(slotNameOf[Slot]) end)
		on(Slot.MoreButtons.Merge.MouseButton1Click, function() MergeSlot(slotNameOf[Slot]) end)
		on(Slot.Buttons.Expand.MouseButton1Click, function()
			Slot.Size = Slot.Size + UDim2.new(0, 0, 0, 30)
			Slot.Buttons.Expand.Visible = false
			Slot.Buttons.Close.Visible = true
		end)
		on(Slot.Buttons.Close.MouseButton1Click, function()
			Slot.Size = Slot.Size - UDim2.new(0, 0, 0, 30)
			Slot.Buttons.Expand.Visible = true
			Slot.Buttons.Close.Visible = false
		end)
		return Slot
	end

	local function rebuildSlots()
		for _, f in pairs(slotFrames) do f:Destroy() end
		slotFrames, slotNameOf = {}, {}
		local names = Store.ListSlots()
		for _, name in ipairs(names) do createSlotFrame(name) end
		reorderSlots(names)
		updateSlotCount()
	end

	local function refreshSlotsIfChanged()
		if not Store.Ready then return end
		local names = Store.ListSlots()
		local same, count = true, 0
		for _, name in ipairs(names) do
			count = count + 1
			if not slotFrames[name] then same = false break end
		end
		if same then
			local shown = 0
			for _ in pairs(slotFrames) do shown = shown + 1 end
			same = shown == count
		end
		if not same then rebuildSlots() end
	end

	-- --------------------------------------------------------------------------------------------- settings rows
	local function bindSettings()
		local SWITCH_ON = { Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(75, 75, 75) }
		local SWITCH_OFF = { Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }
		for _, def in ipairs(SettingsTable) do
			local row = SettingsFrame.List:FindFirstChild(def.name)
			if row then
				local name = def.name
				if def.kind == "toggle" then
					local switch = row:FindFirstChild("Switch")
					local knob = switch and switch:FindFirstChild("Switcher")
					if switch and knob then
						local tOn = ts:Create(knob, TweenInfo.new(0.25), SWITCH_ON)
						local tOff = ts:Create(knob, TweenInfo.new(0.25), SWITCH_OFF)
						local function show(v, instant)
							local target = (v ~= 0) and SWITCH_ON or SWITCH_OFF
							if instant then
								knob.Position, knob.BackgroundColor3 = target.Position, target.BackgroundColor3
							elseif v ~= 0 then tOn:Play() else tOff:Play() end
						end
						show(Settings.Get(name), true)
						on(switch.MouseButton1Click, function()
							Settings.Set(name, Settings.On(name) and 0 or 1)
						end)
						Settings.Changed(name, function(v) show(v, false) end)
					end
				else
					local inp = row:FindFirstChild("Input")
					if inp then
						inp.Text = tostring(Settings.Get(name))
						on(inp.FocusLost, function()
							if not Settings.Set(name, inp.Text) then inp.Text = tostring(Settings.Get(name)) end
						end)
						Settings.Changed(name, function(v) inp.Text = tostring(v) end)
					end
				end
			end
		end
	end

	function Menu.Start(gui, onUnload)
		Gui = gui
		menu = gui.MainMenu
		MobileUI = gui.Mobile
		MergeMenu = gui.Merge
		JoinMessage = gui.JoinMessage
		ControlsFrame = menu.ControlsFrame
		SettingsFrame = menu.SettingsFrame
		SavesFrame = menu.SavesFrame
		HelpFrame = menu.HelpFrame
		MoreFrame = menu.MoreFrame
		if uis.TouchEnabled then
			MobileUI.MenuOpener.Visible = true
			MobileUI.More.Visible = true
			MobileUI.MobileModes.Mode1Mobile.Visible = true
			MobileUI.MobileModes.Mode2Mobile.Visible = true
			MobileUI.MobileModes.Mode3Mobile.Visible = true
			menu.ControlsFrame.Visible = false
			menu.ControlsToggle.Visible = false
			menu.HelpToggle.Position = UDim2.new(0.5, 0, 0.108, 0)
			menu.HelpToggle.Size = UDim2.new(0, 100, 0, 30)
			menu.MoreToggle.Position = UDim2.new(0.75, 0, 0.108, 0)
			menu.MoreToggle.Size = UDim2.new(0, 100, 0, 30)
			menu.SavesToggle.Position = UDim2.new(0.25, 0, 0.108, 0)
			menu.SavesToggle.Size = UDim2.new(0, 100, 0, 30)
			menu.SettingsToggle.Position = UDim2.new(0, 0, 0.108, 0)
			menu.SettingsToggle.Size = UDim2.new(0, 100, 0, 30)
		end

		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
		if viewport.Y < 420 then menu.Size = UDim2.new(0, 400, 0.95, 0) end

		local JoinTween = ts:Create(JoinMessage, TweenInfo.new(1, Enum.EasingStyle.Quad), { Position = UDim2.new(0, 10, 1, -10) })
		local ReverseJoinTween = ts:Create(JoinMessage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(0, 10, 1, 150) })

		-- controls tab
		for i, cdef in ipairs(ControlsTable) do
			local cname = cdef[1]
			local ControlBlock = UI.Template("Control")
			ControlBlock.Name = cname
			ControlBlock.LayoutOrder = i
			ControlBlock.N.Text = cname
			ControlBlock.Key.Text = Controls.Get(cname)
			ControlBlock.Parent = ControlsFrame.List
			Controls.Changed(cname, function(v) ControlBlock.Key.Text = v end)
			on(ControlBlock.Key.MouseButton1Down, function()
				if ChangingInput then
					if WaitInputConnection then WaitInputConnection:Disconnect() end
					local old = ControlsFrame.List:FindFirstChild(ChangingInput)
					if old then old.Key.Text = Controls.Get(ChangingInput) end
				end
				ControlBlock.Key.Text = "Press Any Key"
				ChangingInput = cname
				RunService.RenderStepped:Wait()
				WaitInputConnection = uis.InputBegan:Connect(function(inp, proc)
					if proc and inp.UserInputType == Enum.UserInputType.Keyboard and not Settings.On("Ignore Game Processed") then return end
					local input
					if inp.UserInputType == Enum.UserInputType.Keyboard then input = inp.KeyCode
					elseif inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.MouseButton2 or inp.UserInputType == Enum.UserInputType.MouseButton3 then
						input = inp.UserInputType
					end
					if input and FromKey[input] then
						Controls.Set(ChangingInput, FromKey[input])
						ControlBlock.Key.Text = FromKey[input]
						if WaitInputConnection then WaitInputConnection:Disconnect() end
						ChangingInput = nil
					end
				end)
				Janitor.add(WaitInputConnection)
			end)
		end

		bindSettings()
		SetStatsSize(Settings.Get("Stats Text Size"))
		Settings.Changed("Stats Text Size", function(v) SetStatsSize(v) end)

		if Store.Ready then
			rebuildSlots()
			on(SavesFrame.YourSlots.Top.AddSlot.MouseButton1Click, function()
				local ok, res = Store.CreateSlot(nil)
				if ok then createSlotFrame(res); reorderSlots(); updateSlotCount()
				else SetStatus("Could not add a slot: " .. tostring(res), true) end
			end)
		else
			SavesFrame.YourSlots.Top.Count.Text = "unavailable"
			SavesFrame.YourSlots.Top.AddSlot.Visible = false
		end

		on(MergeMenu.Cancel.MouseButton1Click, function() MergeMenu.Visible = false; pendingMerge = nil end)
		on(MergeMenu.Options.Before.MouseButton1Click, function()
			MergeMenu.Visible = false
			if pendingMerge then local tas = pendingMerge; pendingMerge = nil; Core.SetTAS(tas, "before"); SetStatus("Move into the green hitbox to complete the merge", true) end
		end)
		on(MergeMenu.Options.After.MouseButton1Click, function()
			MergeMenu.Visible = false
			if pendingMerge then local tas = pendingMerge; pendingMerge = nil; Core.SetTAS(tas, "after"); SetStatus("Move into the green hitbox to complete the merge", true) end
		end)

		menu.Title.Text = "HappaTAS " .. VERSION
		JoinMessage.Title.Text = "HappaTAS " .. VERSION .. " Loaded"
		JoinMessage.M.Text = tostring(Controls.Get("Menu")) .. " - Main Menu"
		Controls.Changed("Menu", function(v) JoinMessage.M.Text = tostring(v) .. " - Main Menu" end)
		if not Store.Ready then
			JoinMessage.Size = UDim2.new(0, 280, 0, 110)
			JoinMessage.FailureMessage.Visible = true
		end
		JoinTween:Play()
		on(JoinMessage.Close.MouseButton1Down, function() ReverseJoinTween:Play() end)

		on(uis.InputBegan, function(inp, proc)
			if proc and not Settings.On("Ignore Game Processed") then return end
			if uis:GetFocusedTextBox() then return end
			if CheckInput(inp, "Menu") then menu.Visible = not menu.Visible end
		end)

		local TABS = { "Controls", "Settings", "Saves", "Help", "More" }
		local function tab(TabName)
			for _, t in ipairs(TABS) do
				menu[t .. "Toggle"].BackgroundTransparency = 0.75
				menu[t .. "Frame"].Visible = false
			end
			menu[TabName .. "Toggle"].BackgroundTransparency = 0.5
			menu[TabName .. "Frame"].Visible = true
			if TabName == "Saves" then refreshSlotsIfChanged() end
		end
		for _, t in ipairs(TABS) do
			on(menu[t .. "Toggle"].MouseButton1Click, function() tab(t) end)
		end

		on(MoreFrame.List["1Model"].MouseButton1Click, function() if onUnload then onUnload() end end)
		if MoreFrame.List:FindFirstChild("ToggleMicroProfiler") then
			on(MoreFrame.List.ToggleMicroProfiler.MouseButton1Click, function()
				Settings.Set("Show MicroProfiler", Settings.On("Show MicroProfiler") and 0 or 1)
			end)
		end

		-- expandable help sections
		local hf = HelpFrame.List
		local SelectedHelp = "00"
		for _, v in ipairs(hf:GetChildren()) do
			if v:IsA("TextButton") then
				on(v.MouseButton1Click, function()
					if SelectedHelp ~= v.Name then
						if SelectedHelp ~= "00" then
							hf[SelectedHelp].Expansion.Visible = false
							hf[SelectedHelp].Expand.Text = "+"
							local oldSpacer = hf:FindFirstChild(SelectedHelp .. "Spacer")
							if oldSpacer then oldSpacer:Destroy() end
						end
						SelectedHelp = v.Name
						hf[SelectedHelp].Expansion.Visible = true
						hf[SelectedHelp].Expand.Text = "-"
						local spacer = hf.Spacer:Clone()
						spacer.Parent = hf
						spacer.Name = SelectedHelp .. "Spacer"
						spacer.Size = UDim2.new(0, 0, 0, hf[SelectedHelp].Expansion.Size.Y.Offset - 8)
					else
						hf[SelectedHelp].Expansion.Visible = false
						hf[SelectedHelp].Expand.Text = "+"
						local oldSpacer = hf:FindFirstChild(SelectedHelp .. "Spacer")
						if oldSpacer then oldSpacer:Destroy() end
						SelectedHelp = "00"
					end
				end)
			end
		end

		autoCanvas(ControlsFrame, ControlsFrame.List)
		autoCanvas(SettingsFrame, SettingsFrame.List)
		autoCanvas(HelpFrame, HelpFrame.List, 40)
		autoCanvas(MoreFrame, MoreFrame.List)
		autoCanvas(SavesFrame, SavesFrame.YourSlots, 60)

		on(MobileUI.MenuOpener.MouseButton1Click, function() menu.Visible = not menu.Visible end)
		on(MobileUI.More.MouseButton1Click, function()
			for _, b in ipairs(MobileUI.MobileOptions:GetChildren()) do b.Visible = not b.Visible end
		end)
		if MobileUI.MobileOptions:FindFirstChild("MicroProfiler") then
			on(MobileUI.MobileOptions.MicroProfiler.MouseButton1Click, function()
				Settings.Set("Show MicroProfiler", Settings.On("Show MicroProfiler") and 0 or 1)
			end)
		end
	end
end

