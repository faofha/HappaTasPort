				local n = tl:count()
				while E.frame + 1 <= n and E.testTime > tl:get("TotalTime", E.frame + 1, 1) do E.frame = E.frame + 1 end
				while E.frame > 1 and E.testTime < tl:get("TotalTime", E.frame - 1, 1) do E.frame = E.frame - 1 end
				local f = E.frame
