		local my = statusToken
		status.Text = tostring(text)
		if not inverse then
			status.TextTransparency = 0
			for i = 0, 1.05, 0.05 do
				if statusToken ~= my or Janitor.unloading then return end
				status.TextTransparency = i
				task.wait(0.05)
			end
		else
			status.TextTransparency = 0
			task.wait(2)
			for i = 0, 1.05, 0.05 do
				if statusToken ~= my or Janitor.unloading then return end
				status.TextTransparency = i
				task.wait(0.05)
			end
		end
