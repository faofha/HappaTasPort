					{"UICorner", "UICorner", 37, {}},
				}},
			}},
			{"Frame", "Border", 39, {Position = u(0, 0, 1, 0), Size = u(1, 0, 0, 1), AnchorPoint = v2(0, 1)}},
		}}
	end
	local function numberRow(def)
		local labelSize = (#def.label > 24) and 13 or 16
		return {"Frame", def.name, 34, {Size = u(1, 0, 0, 30), LayoutOrder = def.order * 2}, {
			{"UICorner", "UICorner", 5, {}},
			{"TextBox", "Input", 40, {Position = u(0.9, 0, 0.5, 0), Size = u(0.15, 0, 0.7, 0), AnchorPoint = v2(0.5, 0.5), Text = tostring(def.default), TextSize = 13, PlaceholderText = ""}, {
				{"UICorner", "UICorner", 5, {}},
				{"UIStroke", "UIStroke", 41, {}},
			}},
			{"TextLabel", "N", 35, {Position = u(0, 10, 0, 0), Size = u(0.75, 0, 1, 0), Text = def.label, TextSize = labelSize}},
			{"Frame", "Border", 39, {Position = u(0, 0, 1, 0), Size = u(1, 0, 0, 1), AnchorPoint = v2(0, 1)}},
		}}
	end
	function UI.BuildSettingsRows(list)
		local lastSection
		for _, def in ipairs(SettingsTable) do
			if def.section ~= lastSection then
				lastSection = def.section
				local h = build({"TextLabel", "Section_" .. def.section, 16, {Size = u(1, 0, 0, 28), Text = def.section, TextSize = 14, LayoutOrder = def.order * 2 - 1}})
				pcall(function() h.TextColor3 = Color3.fromRGB(140, 205, 255) end)
				h.Parent = list
			end
			local node = (def.kind == "toggle") and toggleRow(def) or numberRow(def)
			build(node).Parent = list
		end
	end

	function UI.Create()
		local gui = Instance.new("ScreenGui")
		gui.Name = "TASUserInterface"
		gui.ResetOnSpawn = false
		pcall(function() gui.ZIndexBehavior = Enum.ZIndexBehavior.Global end)
		pcall(function() gui.DisplayOrder = 0 end)
		for _, node in ipairs(UI_TREE) do
			build(node).Parent = gui
		end
		UI.BuildSettingsRows(gui.MainMenu.SettingsFrame.List)
		return gui
	end

	-- parents a ScreenGui where game scripts can't read it (gethui -> CoreGui -> PlayerGui)
	function UI.Attach(gui)
		if Env.protectgui then pcall(Env.protectgui, gui) end
		local candidates = {}
		if Env.gethui then
			local ok, h = pcall(Env.gethui)
			if ok and typeof(h) == "Instance" then candidates[#candidates + 1] = h end
		end
		local core = svc("CoreGui")
		if core then candidates[#candidates + 1] = core end
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
		if pg then candidates[#candidates + 1] = pg end

		for i, parent in ipairs(candidates) do
			if parent == pg then
				-- last resort: visible to game scripts, so don't use an obvious name
				gui.Name = HttpService and HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12) or gui.Name
			end
			local ok = pcall(function() gui.Parent = parent end)
			if ok and gui.Parent ~= nil then
				UI.ParentName = (parent == pg) and "PlayerGui" or ((i == 1 and Env.gethui) and "gethui" or "CoreGui")
				return true
			end
		end
		return false
	end

	-- extra ScreenGuis (cursor, profiler) that sit above everything
	function UI.Overlay(name, displayOrder)
		local sg = Instance.new("ScreenGui")
		sg.Name = name
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		pcall(function() sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
		pcall(function() sg.DisplayOrder = displayOrder end)
		if not UI.Attach(sg) then
			sg:Destroy()
			return nil
		end
		Janitor.add(sg)
		return sg
	end
end

-- ================================================================================================
--  CODEC  (.tas binary format)
--
--  "HTAS" | u8 version | u8 flags (bit0 LZ4, bit1 has mouse) | varint frames | varint rawLen
--  | zigzag mouseX0 | zigzag mouseY0 | payload (raw or LZ4 block)
--  raw = for every column: varint length + bytes.
--    v1 columns: FA FB DT TA PX PY PZ ROT LV AV ST CR CP ZM PO JT SP AN MS IN MB
--    v2 adds:    CO OB                      (client objects + object table)
--    v3 adds:    FC VP TL TS BE BK          (extra flags, viewport, tools, tool names, buttons, button table)
--  FC bits: 1 viewport changed, 2 tool events, 4 died this frame, 8 button events
--  Old v1 / v2 files load exactly like before.
-- ================================================================================================
local Codec = {}
do
	local MAGIC = "HTAS"
	local SCROLL_MARK = 0x7F
	Codec.ScrollBase = 10000

	local COLUMNS_V1 = { "FA", "FB", "DT", "TA", "PX", "PY", "PZ", "ROT", "LV", "AV", "ST", "CR", "CP", "ZM", "PO", "JT", "SP", "AN", "MS", "IN", "MB" }
	local COLUMNS_V2, COLUMNS_V3 = {}, {}
	for i, n in ipairs(COLUMNS_V1) do COLUMNS_V2[i] = n; COLUMNS_V3[i] = n end
	for _, n in ipairs({ "CO", "OB" }) do COLUMNS_V2[#COLUMNS_V2 + 1] = n; COLUMNS_V3[#COLUMNS_V3 + 1] = n end
	for _, n in ipairs({ "FC", "VP", "TL", "TS", "BE", "BK" }) do COLUMNS_V3[#COLUMNS_V3 + 1] = n end
	local COLUMNS_FOR = { COLUMNS_V1, COLUMNS_V2, COLUMNS_V3 }

	local TOOL_CODE = { Equip = 1, Unequip = 2, Activate = 3, Deactivate = 4 }
	local TOOL_NAME = { "Equip", "Unequip", "Activate", "Deactivate" }

	local floor = math.floor
	local char, byte, sub = string.char, string.byte, string.sub
	local HUGE = math.huge

	local function q(v, scale)
		if type(v) ~= "number" or v ~= v or v == HUGE or v == -HUGE then return 0 end
		return floor(v * scale + 0.5)
	end

	local function putVar(buf, n)
		n = floor(n or 0)
		if n < 0 then n = 0 end
		local i = #buf
		while n >= 128 do
			local m = n % 128
			i = i + 1
			buf[i] = m + 128
			n = (n - m) / 128
		end
		buf[i + 1] = n
	end
	local function putZig(buf, v)
		v = floor(v or 0)
		if v >= 0 then putVar(buf, v * 2) else putVar(buf, -v * 2 - 1) end
	end
	local function putStr(buf, s)
		putVar(buf, #s)
		local i = #buf
		for k = 1, #s do buf[i + k] = byte(s, k) end
	end

	local function bufToString(buf)
		local parts = {}
		local n = #buf
		local i = 1
		while i <= n do
			local j = i + 3999
			if j > n then j = n end
			parts[#parts + 1] = char(table.unpack(buf, i, j))
			i = j + 1
		end
		return table.concat(parts)
	end

	Codec.PutVar, Codec.PutZig, Codec.BufToString = putVar, putZig, bufToString

	local function newReader(s, p, n)
		return { s = s, p = p or 1, n = n or #s }
	end
	local function getByte(rd)
		local p = rd.p
		if p > rd.n then error("unexpected end of data", 0) end
		rd.p = p + 1
		return byte(rd.s, p)
	end
	local function getVar(rd)
		local result, mul = 0, 1
		while true do
			local b = getByte(rd)
			if b < 128 then return result + b * mul end
			result = result + (b - 128) * mul
			mul = mul * 128
			if mul > 2 ^ 49 then error("bad number", 0) end
		end
	end
	local function getZig(rd)
		local z = getVar(rd)
		if z % 2 == 0 then return floor(z / 2) end
		return -floor((z + 1) / 2)
	end
	local function getStr(rd)
		local len = getVar(rd)
		local p = rd.p
		if p + len - 1 > rd.n then error("text is cut off", 0) end
		rd.p = p + len
		return sub(rd.s, p, p + len - 1)
	end

	-- pure Lua LZ4 block decoder (only used when the executor has no lz4decompress)
	local function lz4Fallback(src, usize)
		local out, on = {}, 0
		local i, n = 1, #src
		while i <= n do
			local token = byte(src, i); i = i + 1
			local lit = floor(token / 16)
			if lit == 15 then
				repeat
					local b = byte(src, i); i = i + 1
					if not b then error("lz4: bad literal length", 0) end
					lit = lit + b
				until b ~= 255
			end
			if i + lit - 1 > n or on + lit > usize then error("lz4: literals out of range", 0) end
			for k = 0, lit - 1 do out[on + k + 1] = byte(src, i + k) end
			on = on + lit
			i = i + lit
			if i > n then break end
			local b1, b2 = byte(src, i, i + 1)
			if not b2 then error("lz4: bad offset", 0) end
			local off = b1 + b2 * 256; i = i + 2
			if off == 0 or off > on then error("lz4: bad offset", 0) end
			local ml = token % 16
			if ml == 15 then
				repeat
					local b = byte(src, i); i = i + 1
					if not b then error("lz4: bad match length", 0) end
					ml = ml + b
				until b ~= 255
			end
			ml = ml + 4
			if on + ml > usize then error("lz4: output too big", 0) end
			local start = on - off
			for k = 1, ml do out[on + k] = out[start + k] end
			on = on + ml
			if on % 65536 < ml then task.wait() end
		end
		if on ~= usize then error("lz4 size mismatch", 0) end
		return bufToString(out)
	end

	local function lz4Decompress(data, usize)
		if Env.lz4decompress then
			local ok, res = pcall(Env.lz4decompress, data, usize)
			if ok and type(res) == "string" and #res == usize then return res end
		end
		return lz4Fallback(data, usize)
	end
	Codec.Lz4Decompress = lz4Decompress

	-- frames: list of frame tables, objects: { {id, key} } client objects, buttons: { {id, key} } buttons
	function Codec.Encode(frames, progress, objects, buttons)
		local cols = {}
		for _, name in ipairs(COLUMNS_V3) do cols[name] = {} end
		local coParts = {}
		local hasCO = false
		local FA, FB, DT, TA, PX, PY, PZ = cols.FA, cols.FB, cols.DT, cols.TA, cols.PX, cols.PY, cols.PZ
		local ROT, LV, AV, ST, CR, CP, ZM = cols.ROT, cols.LV, cols.AV, cols.ST, cols.CR, cols.CP, cols.ZM
		local PO, JT, SP, AN, MS, IN, MB = cols.PO, cols.JT, cols.SP, cols.AN, cols.MS, cols.IN, cols.MB
		local FC, VP, TL, BE = cols.FC, cols.VP, cols.TL, cols.BE
		local v3 = (buttons and #buttons > 0) or false

		local total = #frames
		local hasMouse, mouse0x, mouse0y = false, 0, 0
		for i = 1, total do
			local f = frames[i]
			if f.MX then
				hasMouse = true
				mouse0x, mouse0y = q(f.MX, 1), q(f.MY or 0, 1)
				break
			end
		end

		local pPos = { 0, 0, 0 }
		local pRot = { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
		local pLV = { 0, 0, 0 }
		local pAV = { 0, 0, 0 }
		local pState = -1
		local pCamRot = { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
		local pCamOff = { 0, 0, 0 }
		local pZoom = 0
		local pPose = -1
		local pJump, pSpeed = 0, 0
		local pMX, pMY = mouse0x, mouse0y
		local pDT, pTotal = 0, 0
		local pVX, pVY = 0, 0
		local toolIndex, toolNames = {}, {}
		local rv, cv = {}, {}

		for i = 1, total do
			local f = frames[i]
			local fa, fb, fc = 0, 0, 0

			local dt = q(f.FrameTime, 1000000)
			local tot = q(f.TotalTime, 1000000)
			putZig(DT, dt - pDT)
			putZig(TA, tot - (pTotal + dt))
			pDT, pTotal = dt, tot

			local cf = f.Cframe
			local x, y, z = q(cf[1], 1000), q(cf[2], 1000), q(cf[3], 1000)
			putZig(PX, x - pPos[1]); putZig(PY, y - pPos[2]); putZig(PZ, z - pPos[3])
			pPos[1], pPos[2], pPos[3] = x, y, z
			local rotChanged = false
			for k = 1, 9 do
				local v = q(cf[3 + k], 1000)
				rv[k] = v
				if v ~= pRot[k] then rotChanged = true end
			end
			if rotChanged then
				fa = fa + 1
				for k = 1, 9 do putZig(ROT, rv[k] - pRot[k]); pRot[k] = rv[k] end
			end

			local vel = f.Velocity
			local lin, ang = vel.Linear, vel.Angular
			local l1, l2, l3 = q(lin[1], 1000), q(lin[2], 1000), q(lin[3], 1000)
			if l1 ~= pLV[1] or l2 ~= pLV[2] or l3 ~= pLV[3] then
				fa = fa + 2
				putZig(LV, l1 - pLV[1]); putZig(LV, l2 - pLV[2]); putZig(LV, l3 - pLV[3])
				pLV[1], pLV[2], pLV[3] = l1, l2, l3
			end
			local a1, a2, a3 = q(ang[1], 1000), q(ang[2], 1000), q(ang[3], 1000)
			if a1 ~= pAV[1] or a2 ~= pAV[2] or a3 ~= pAV[3] then
				fa = fa + 4
				putZig(AV, a1 - pAV[1]); putZig(AV, a2 - pAV[2]); putZig(AV, a3 - pAV[3])
				pAV[1], pAV[2], pAV[3] = a1, a2, a3
			end

			local st = floor(tonumber(f.State) or 0)
			if st ~= pState then
				fa = fa + 8
				ST[#ST + 1] = st % 256
				pState = st
			end

			local cc = f.CamCframe
			local camChanged = false
			for k = 1, 9 do
				local v = q(cc[3 + k], 1000)
				cv[k] = v
				if v ~= pCamRot[k] then camChanged = true end
			end
			if camChanged then
				fa = fa + 16
				for k = 1, 9 do putZig(CR, cv[k] - pCamRot[k]); pCamRot[k] = cv[k] end
			end
			local o1, o2, o3 = q(cc[1], 1000) - x, q(cc[2], 1000) - y, q(cc[3], 1000) - z
			if o1 ~= pCamOff[1] or o2 ~= pCamOff[2] or o3 ~= pCamOff[3] then
				fa = fa + 32
				putZig(CP, o1 - pCamOff[1]); putZig(CP, o2 - pCamOff[2]); putZig(CP, o3 - pCamOff[3])
				pCamOff[1], pCamOff[2], pCamOff[3] = o1, o2, o3
			end
			local zoom = q(f.Zoom, 1000)
			if zoom ~= pZoom then
				fa = fa + 64
				putZig(ZM, zoom - pZoom)
				pZoom = zoom
			end
			if f.ShiftLock == 1 then fa = fa + 128 end

			local an = f.Anim
			if an then
				local pose = floor(tonumber(an.Pose) or 0)
				if pose ~= pPose then
					fb = fb + 1
					PO[#PO + 1] = pose % 256
					pPose = pose
				end
				local jt = q(an.JumpTime or 0, 1000)
				if jt ~= pJump then
					fb = fb + 2
					putZig(JT, jt - pJump)
					pJump = jt
				end
				local sp = q(an.Speed or 1, 1000)
				if sp ~= pSpeed then
					fb = fb + 4
					putZig(SP, sp - pSpeed)
					pSpeed = sp
				end
				local list = an.Anims
				if list and #list > 0 then
					fb = fb + 8
					local cnt = math.min(#list, 255)
					AN[#AN + 1] = cnt
					for k = 1, cnt do
						local a = list[k]
						AN[#AN + 1] = floor(tonumber(a[1]) or 0) % 256
						putVar(AN, math.max(0, q(a[2] or 0, 1000)))
					end
				end
			end

			if hasMouse and f.MX then
				local mx, my = q(f.MX, 1), q(f.MY or 0, 1)
				if mx ~= pMX or my ~= pMY then
					fb = fb + 16
					putZig(MS, mx - pMX); putZig(MS, my - pMY)
					pMX, pMY = mx, my
				end
			end

			local ev = f.Input
			if ev and #ev > 0 then
				fb = fb + 32
				putVar(IN, #ev)
				for _, e in ipairs(ev) do
					if e >= Codec.ScrollBase - 5000 then
						IN[#IN + 1] = SCROLL_MARK
						putZig(IN, e - Codec.ScrollBase)
					elseif e > 0 then
						IN[#IN + 1] = e % 128
					else
						IN[#IN + 1] = (-e) % 128 + 128
					end
				end
			end

			local mob = f.Mobile
			if type(mob) == "table" then
				fb = fb + 64
				local hasStick = mob.JoystickX ~= nil and mob.JoystickY ~= nil
				local d = mob.Dynamic
				local hasDyn = type(d) == "table" and d.Start ~= nil and d.End ~= nil
				MB[#MB + 1] = (mob.Jumping == 1 and 1 or 0) + (hasStick and 2 or 0) + (hasDyn and 4 or 0)
				if hasStick then
					putZig(MB, q(mob.JoystickX, 1)); putZig(MB, q(mob.JoystickY, 1))
				end
				if hasDyn then
					putZig(MB, q(d.Start[1], 1)); putZig(MB, q(d.Start[2], 1)); putVar(MB, q(d.Start[3], 100))
					putZig(MB, q(d.End[1], 1)); putZig(MB, q(d.End[2], 1)); putVar(MB, q(d.End[3], 100))
					local mList = d.Middles or {}
					local cnt = math.min(#mList, 15)
					putVar(MB, cnt)
					for k = 1, cnt do
						local m = mList[k]
						putZig(MB, q(m[1], 1)); putZig(MB, q(m[2], 1)); putVar(MB, q(m[3], 100))
						putVar(MB, math.max(0, q(m[4] or 0, 1)))
						putVar(MB, math.max(0, q(m[5] or 0, 1)))
					end
				end
			end

			if f.CO then
				hasCO = true
				fb = fb + 128
				local hdr = {}
				putVar(hdr, #f.CO)
				coParts[#coParts + 1] = bufToString(hdr)
				coParts[#coParts + 1] = f.CO
			end

			-- v3 extras
			if f.VX then
				local vx, vy = q(f.VX, 10), q(f.VY or 0, 10)
				if vx ~= pVX or vy ~= pVY then
					fc = fc + 1
					putZig(VP, vx - pVX); putZig(VP, vy - pVY)
					pVX, pVY = vx, vy
				end
			end
			local tools = f.Tools
			if type(tools) == "table" and #tools > 0 then
				fc = fc + 2
				local cnt = math.min(#tools, 255)
				putVar(TL, cnt)
				for k = 1, cnt do
					local t = tools[k]
					local name = tostring(t.Name or "")
					local idx = toolIndex[name]
					if not idx then
						idx = #toolNames + 1
						toolNames[idx] = name
						toolIndex[name] = idx
					end
					TL[#TL + 1] = TOOL_CODE[t.Action] or 0
					putVar(TL, idx)
				end
			end
			if f.Died then fc = fc + 4 end
			local bt = f.BT
			if type(bt) == "table" and #bt > 0 then
				fc = fc + 8
				putVar(BE, #bt)
				for k = 1, #bt do
					local e = bt[k]
					putVar(BE, e[1])
					BE[#BE + 1] = (e[2] == 1) and 1 or 0
					putVar(BE, math.max(0, q(e[3] or 0, 1000)))
				end
			end
			if fc ~= 0 then v3 = true end

			FA[#FA + 1] = fa
			FB[#FB + 1] = fb
			FC[#FC + 1] = fc

			if i % 1500 == 0 then
				if progress then progress(i, total) end
				task.wait()
			end
		end

		local version = 1
		if hasCO or (objects and #objects > 0) then version = 2 end
		if v3 then version = 3 end
		if version >= 2 then
			local OB = cols.OB
			putVar(OB, #(objects or {}))
			for _, o in ipairs(objects or {}) do
				putVar(OB, o.id)
				putStr(OB, o.key)
			end
		end
		if version >= 3 then
			local TS = cols.TS
			putVar(TS, #toolNames)
			for _, name in ipairs(toolNames) do putStr(TS, name) end
			local BK = cols.BK
			putVar(BK, #(buttons or {}))
			for _, b in ipairs(buttons or {}) do
				putVar(BK, b.id)
				putStr(BK, b.key)
			end
		end

		local rawParts = {}
		for _, name in ipairs(COLUMNS_FOR[version]) do
			local s
			if name == "CO" then s = table.concat(coParts) else s = bufToString(cols[name]) end
			local hdr = {}
			putVar(hdr, #s)
			rawParts[#rawParts + 1] = bufToString(hdr)
			rawParts[#rawParts + 1] = s
		end
		local raw = table.concat(rawParts)

		local compressed, flags = nil, 0
		if hasMouse then flags = flags + 2 end
		if Env.HasLZ4 and #raw > 64 then
			local ok, res = pcall(Env.lz4compress, raw)
			if ok and type(res) == "string" and #res < #raw then
				local okD, back = pcall(Env.lz4decompress, res, #raw)
				if okD and back == raw then
					compressed = res
					flags = flags + 1
				end
			end
		end

		local head = {}
		putVar(head, total)
		putVar(head, #raw)
		putZig(head, mouse0x)
		putZig(head, mouse0y)
		local file = MAGIC .. char(version, flags) .. bufToString(head) .. (compressed or raw)
		return file, { frames = total, rawBytes = #raw, fileBytes = #file, compressed = compressed ~= nil, version = version }
	end

	function Codec.IsCompact(data)
		return type(data) == "string" and sub(data, 1, 4) == MAGIC
	end

	function Codec.Decode(data, progress)
		if not Codec.IsCompact(data) then error("not a HappaTAS binary file", 0) end
		if #data > CONFIG.MaxFileBytes then error("file is too big", 0) end
		local version, flags = byte(data, 5), byte(data, 6)
		if version ~= 1 and version ~= 2 and version ~= 3 then error("unsupported file version " .. tostring(version), 0) end
		local rd = newReader(data, 7)
		local total = getVar(rd)
		local rawLen = getVar(rd)
		local mouse0x = getZig(rd)
		local mouse0y = getZig(rd)
		if rawLen > CONFIG.MaxFileBytes then error("file is too big", 0) end
		if total > rawLen then error("frame count is broken", 0) end
		local payload = sub(data, rd.p)
		local raw
		if flags % 2 == 1 then
			raw = lz4Decompress(payload, rawLen)
		else
			raw = payload
		end
		if #raw ~= rawLen then error("size mismatch", 0) end
		local hasMouse = floor(flags / 2) % 2 == 1

		local R = {}
		local rr = newReader(raw)
		for _, name in ipairs(COLUMNS_FOR[version]) do
			local len = getVar(rr)
			local start = rr.p
			if start + len - 1 > #raw then error("column " .. name .. " is cut off", 0) end
			R[name] = newReader(raw, start, start + len - 1)
			rr.p = start + len
		end
		if rr.p ~= #raw + 1 then error("trailing data", 0) end
		local function colLen(c) return c.n - c.p + 1 end
		if colLen(R.FA) ~= total or colLen(R.FB) ~= total or (R.FC and colLen(R.FC) ~= total) then
			error("frame flags don't match the frame count", 0)
		end

		-- v3 tables first (frames reference them)
		local toolNames = {}
		if R.TS then
			local cnt = getVar(R.TS)
			if cnt > colLen(R.TS) then error("tool table is broken", 0) end
			for k = 1, cnt do toolNames[k] = getStr(R.TS) end
		end

		local frames = {}
		local FA, FB, FC, DT, TA, PX, PY, PZ = R.FA, R.FB, R.FC, R.DT, R.TA, R.PX, R.PY, R.PZ
		local pPos = { 0, 0, 0 }
		local pRot = { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
		local pLV = { 0, 0, 0 }
		local pAV = { 0, 0, 0 }
		local pState = 0
		local pCamRot = { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
		local pCamOff = { 0, 0, 0 }
		local pZoom = 0
		local pPose = 0
		local pJump, pSpeed = 0, 0
		local pMX, pMY = mouse0x, mouse0y
		local pDT, pTotal = 0, 0
		local pVX, pVY = 0, 0

		for i = 1, total do
			local fa, fb = getByte(FA), getByte(FB)
			local fc = FC and getByte(FC) or 0
			local f = {}

			local dt = pDT + getZig(DT)
			local tot = pTotal + dt + getZig(TA)
			pDT, pTotal = dt, tot
			f.FrameTime = dt / 1000000
			f.TotalTime = tot / 1000000

			pPos[1] = pPos[1] + getZig(PX); pPos[2] = pPos[2] + getZig(PY); pPos[3] = pPos[3] + getZig(PZ)
			if fa % 2 == 1 then
				for k = 1, 9 do pRot[k] = pRot[k] + getZig(R.ROT) end
			end
			local cf = { pPos[1] / 1000, pPos[2] / 1000, pPos[3] / 1000 }
			for k = 1, 9 do cf[3 + k] = pRot[k] / 1000 end
			f.Cframe = cf

			if floor(fa / 2) % 2 == 1 then
				pLV[1] = pLV[1] + getZig(R.LV); pLV[2] = pLV[2] + getZig(R.LV); pLV[3] = pLV[3] + getZig(R.LV)
			end
			if floor(fa / 4) % 2 == 1 then
				pAV[1] = pAV[1] + getZig(R.AV); pAV[2] = pAV[2] + getZig(R.AV); pAV[3] = pAV[3] + getZig(R.AV)
			end
			f.Velocity = {
				Linear = { pLV[1] / 1000, pLV[2] / 1000, pLV[3] / 1000 },
				Angular = { pAV[1] / 1000, pAV[2] / 1000, pAV[3] / 1000 },
			}

			if floor(fa / 8) % 2 == 1 then pState = getByte(R.ST) end
			f.State = pState

			if floor(fa / 16) % 2 == 1 then
				for k = 1, 9 do pCamRot[k] = pCamRot[k] + getZig(R.CR) end
			end
			if floor(fa / 32) % 2 == 1 then
				pCamOff[1] = pCamOff[1] + getZig(R.CP); pCamOff[2] = pCamOff[2] + getZig(R.CP); pCamOff[3] = pCamOff[3] + getZig(R.CP)
			end
			local cc = { (pPos[1] + pCamOff[1]) / 1000, (pPos[2] + pCamOff[2]) / 1000, (pPos[3] + pCamOff[3]) / 1000 }
			for k = 1, 9 do cc[3 + k] = pCamRot[k] / 1000 end
			f.CamCframe = cc

			if floor(fa / 64) % 2 == 1 then pZoom = pZoom + getZig(R.ZM) end
			f.Zoom = pZoom / 1000
			f.ShiftLock = (fa >= 128) and 1 or 0

			if fb % 2 == 1 then pPose = getByte(R.PO) end
			if floor(fb / 2) % 2 == 1 then pJump = pJump + getZig(R.JT) end
			if floor(fb / 4) % 2 == 1 then pSpeed = pSpeed + getZig(R.SP) end
			local anims = {}
			if floor(fb / 8) % 2 == 1 then
				local cnt = getByte(R.AN)
				for k = 1, cnt do
					local num = getByte(R.AN)
					local ms = getVar(R.AN)
					anims[k] = { num, ms / 1000 }
				end
			end
			f.Anim = { Pose = pPose, JumpTime = pJump / 1000, Speed = pSpeed / 1000, Anims = anims }

			if hasMouse then
				if floor(fb / 16) % 2 == 1 then
					pMX = pMX + getZig(R.MS); pMY = pMY + getZig(R.MS)
				end
				f.MX, f.MY = pMX, pMY
			end

			if floor(fb / 32) % 2 == 1 then
				local cnt = getVar(R.IN)
				if cnt > colLen(R.IN) + 1 then error("input list is broken", 0) end
				local ev = {}
				for k = 1, cnt do
					local b = getByte(R.IN)
					if b == SCROLL_MARK then
						ev[k] = Codec.ScrollBase + getZig(R.IN)
					elseif b >= 128 then
						ev[k] = -(b - 128)
					else
						ev[k] = b
					end
				end
				f.Input = ev
			end

			if floor(fb / 64) % 2 == 1 then
				local mf = getByte(R.MB)
				local mob = { Jumping = mf % 2 }
				if floor(mf / 2) % 2 == 1 then
					mob.JoystickX = getZig(R.MB)
					mob.JoystickY = getZig(R.MB)
				end
				if floor(mf / 4) % 2 == 1 then
					local sx = getZig(R.MB); local sy = getZig(R.MB); local str = getVar(R.MB) / 100
					local ex = getZig(R.MB); local ey = getZig(R.MB); local etr = getVar(R.MB) / 100
					local mCount = getVar(R.MB)
					if mCount > 15 then error("thumbstick data is broken", 0) end
					local mids = {}
					for k = 1, mCount do
						mids[k] = { getZig(R.MB), getZig(R.MB), getVar(R.MB) / 100, getVar(R.MB), getVar(R.MB) }
					end
					mob.Dynamic = { Start = { sx, sy, str }, End = { ex, ey, etr }, Middles = mids }
				end
				f.Mobile = mob
			else
				f.Mobile = 0
			end

			if floor(fb / 128) % 2 == 1 then
				if not R.CO then error("client object data is missing", 0) end
				local len = getVar(R.CO)
				local from = R.CO.p
				if len < 1 or from + len - 1 > R.CO.n then error("client object data is cut off", 0) end
				f.CO = sub(raw, from, from + len - 1)
				R.CO.p = from + len
			end

			if fc ~= 0 then
				if fc % 2 == 1 then
					pVX = pVX + getZig(R.VP); pVY = pVY + getZig(R.VP)
				end
				if floor(fc / 2) % 2 == 1 then
					local cnt = getVar(R.TL)
					local list = {}
					for k = 1, cnt do
						local code = getByte(R.TL)
						local idx = getVar(R.TL)
						local act, name = TOOL_NAME[code], toolNames[idx]
						if act and name then list[#list + 1] = { Action = act, Name = name } end
					end
					if #list > 0 then f.Tools = list end
				end
				if floor(fc / 4) % 2 == 1 then f.Died = true end
				if floor(fc / 8) % 2 == 1 then
					local cnt = getVar(R.BE)
					if cnt > colLen(R.BE) + 1 then error("button list is broken", 0) end
					local list = {}
					for k = 1, cnt do
						local id = getVar(R.BE)
						local stv = getByte(R.BE)
						local el = getVar(R.BE) / 1000
						list[k] = { id, stv == 1 and 1 or 0, el }
					end
					f.BT = list
				end
			end
			if pVX > 0 and pVY > 0 then
				f.VX, f.VY = pVX / 10, pVY / 10
				if f.MX then
					f.UVX = clampn(f.MX / f.VX, 0, 1)
					f.UVY = clampn(f.MY / f.VY, 0, 1)
				end
			end

			frames[i] = f
			if i % 1500 == 0 then
				if progress then progress(i, total) end
				task.wait()
			end
		end

		for name, rdr in pairs(R) do
			if name ~= "OB" and name ~= "TS" and name ~= "BK" and rdr.p ~= rdr.n + 1 then
				error("column " .. name .. " was not read completely", 0)
			end
		end

		local function readTable(rdr, what)
			local list = {}
			if rdr and rdr.n >= rdr.p then
				local cnt = getVar(rdr)
				if cnt > colLen(rdr) then error(what .. " table is broken", 0) end
				for k = 1, cnt do
					local id = getVar(rdr)
					list[k] = { id = id, key = getStr(rdr) }
				end
			end
			if rdr and rdr.p ~= rdr.n + 1 then error(what .. " table was not read completely", 0) end
			return list
		end
		local objects = R.OB and readTable(R.OB, "object") or nil
		local buttons = R.BK and readTable(R.BK, "button") or nil
		if R.TS and R.TS.p ~= R.TS.n + 1 then error("tool table was not read completely", 0) end
		return frames, objects, buttons
	end
end

-- ================================================================================================
--  STORAGE   <workspace>/HappaTasPort/<PlaceId>/<slot>.tas   +   HappaTasPort/Settings.json
-- ================================================================================================
do
	local ROOT = CONFIG.RootFolder
	local PLACE = tostring(game.PlaceId)
	local PLACE_PATH = ROOT .. "/" .. PLACE
	local SETTINGS_PATH = ROOT .. "/Settings.json"
	local LEGACY_WRAP = "\0LZ4\1"   -- V2.34 wrapped the (already compressed) file a second time

	Store.Available = Env.HasFiles
	Store.Ready = false
	Store.RootPath = ROOT
	Store.PlacePath = PLACE_PATH

	local function call(f, ...)
		local ok, a = pcall(f, ...)
		if ok then return true, a end
		return false, a
	end
	local function fileExists(path)
		local ok, res = call(Env.isfile, path)
		return ok and res == true
	end
	local function folderExists(path)
		local ok, res = call(Env.isfolder, path)
		return ok and res == true
	end
	local function ensureFolders()
		if not folderExists(ROOT) then call(Env.makefolder, ROOT) end
		if not folderExists(PLACE_PATH) then call(Env.makefolder, PLACE_PATH) end
	end

	function Store.Init()
		if not Env.HasFiles then return false end
		ensureFolders()
		Store.Ready = folderExists(PLACE_PATH)
		return Store.Ready
	end

	local RESERVED = { CON = true, PRN = true, AUX = true, NUL = true }
	for i = 1, 9 do
		RESERVED["COM" .. i] = true
		RESERVED["LPT" .. i] = true
	end

	-- a slot name can never leave the place folder (no separators, no dots at the end, no control chars)
	function Store.CleanName(s)
		s = tostring(s or "")
		s = s:gsub("[%c<>:\"/\\|%?%*]", "")
		s = s:gsub("^%s+", "")
		s = s:gsub("%s+$", "")
		s = s:gsub("[%. ]+$", "")
		s = s:gsub("^%.+", "")
		local n = utf8.len(s)
		if n and n > 60 then
			s = s:sub(1, utf8.offset(s, 61) - 1)
		elseif not n then
			s = s:gsub("[\128-\255]", "")
		end
		if s == "" then return nil end
		if RESERVED[s:upper()] then s = "_" .. s end
		return s
	end

	local EXT_NEW, EXT_OLD = ".tas", ".json"
	local function slotPath(name, ext)
		return PLACE_PATH .. "/" .. name .. (ext or EXT_NEW)
	end
	Store.SlotPath = slotPath

	local function findSlotFile(name)
		local p = slotPath(name, EXT_NEW)
		if fileExists(p) then return p, EXT_NEW end
		p = slotPath(name, EXT_OLD)
		if fileExists(p) then return p, EXT_OLD end
		return nil
	end

	local function naturalKey(s)
		return (s:lower():gsub("%d+", function(d)
			if #d < 12 then d = string.rep("0", 12 - #d) .. d end
			return d
		end))
	end

	function Store.Exists(name)
		return findSlotFile(name) ~= nil
	end

	function Store.ListSlots()
		local out, seen = {}, {}
		if not Store.Ready then return out end
		local ok, files = call(Env.listfiles, PLACE_PATH)
		if not ok or type(files) ~= "table" then return out end
		for _, path in ipairs(files) do
			local fname = tostring(path):match("([^/\\]+)$")
			if fname then
				local base = fname:match("^(.+)%.[Tt][Aa][Ss]$") or fname:match("^(.+)%.[Jj][Ss][Oo][Nn]$")
				if base and not seen[base] and not base:find("~rename", 1, true) and fileExists(PLACE_PATH .. "/" .. fname) then
					seen[base] = true
					out[#out + 1] = base
				end
			end
		end
		table.sort(out, function(a, b)
			local ka, kb = naturalKey(a), naturalKey(b)
			if ka == kb then return a < b end
			return ka < kb
		end)
		return out
	end

	function Store.NextDefaultName()
		local n = 1
		while Store.Exists("Slot " .. n) do n = n + 1 end
		return "Slot " .. n
	end

	-- legacy JSON slots (very old HappaTAS / first port versions)
	local function unpackFrame(frame)
		return {
			Cframe = frame[1],
			Velocity = { Linear = frame[2][1], Angular = frame[2][2] },
			State = frame[3],
			CamCframe = frame[4],
			ShiftLock = frame[5],
			Mobile = (type(frame[6]) == "table" and { Jumping = frame[6][1], JoystickX = frame[6][2], JoystickY = frame[6][3] }) or 0,
			Anim = { Pose = frame[7][1], JumpTime = frame[7][2], Speed = frame[7][3], Anims = frame[7][4] or {} },
			Zoom = frame[8],
			FrameTime = frame[9],
			TotalTime = frame[10],
		}
	end
	local function isNum(v) return type(v) == "number" and v == v end
	local function validFrame(frame)
		return type(frame) == "table" and type(frame[1]) == "table" and #frame[1] >= 12
			and type(frame[2]) == "table" and type(frame[2][1]) == "table" and type(frame[2][2]) == "table"
			and isNum(frame[3]) and type(frame[4]) == "table" and #frame[4] >= 12
			and type(frame[7]) == "table" and isNum(frame[8]) and isNum(frame[9]) and isNum(frame[10])
	end

	local function writeSlotFile(name, bytes)
		ensureFolders()
		local path = slotPath(name, EXT_NEW)
		local ok, err = call(Env.writefile, path, bytes)
		if not ok then return false, tostring(err) end
		local okR, back = call(Env.readfile, path)
		if not okR or type(back) ~= "string" or #back ~= #bytes then
			return false, "the file could not be verified after writing"
		end
		return true, path, EXT_NEW
	end

	function Store.CreateSlot(name)
		if not Store.Ready then return false, "Saving is unavailable" end
		name = Store.CleanName(name) or Store.NextDefaultName()
		if Store.Exists(name) then return false, "A slot with that name already exists" end
		local okE, bytes = pcall(Codec.Encode, {})
		if not okE then return false, tostring(bytes) end
		local ok, err = writeSlotFile(name, bytes)
		if not ok then return false, err end
		return true, name
	end

	local function frameIsComplete(f)
		return type(f.Cframe) == "table" and f.State ~= nil and type(f.Velocity) == "table" and type(f.CamCframe) == "table"
			and type(f.FrameTime) == "number" and type(f.TotalTime) == "number"
	end

	function Store.SaveSlot(name, allFrames, progress)
		if not Store.Ready then return false, "Saving is unavailable" end
		local frames = {}
		for _, f in ipairs(allFrames) do
			if frameIsComplete(f) then frames[#frames + 1] = f end
		end
		local okO, objects = pcall(ClientObjects.ExportObjects, frames)
		local okB, buttons = pcall(Buttons.ExportKeys, frames)
		local okE, bytes, info = pcall(Codec.Encode, frames, progress, okO and objects or nil, okB and buttons or nil)
		if not okE then return false, tostring(bytes) end
		local ok, path = writeSlotFile(name, bytes)
		if not ok then return false, path end
		if fileExists(slotPath(name, EXT_OLD)) then call(Env.delfile, slotPath(name, EXT_OLD)) end
		return true, #frames, #bytes, info
	end

	local function loadLegacyJson(raw, progress)
		local frames = {}
		local nl = raw:find("\n", 1, true)
		local head = nl and raw:sub(1, nl - 1) or ""
		if head:sub(-11) == '"batches":[' then
			local lines = {}
			for line in raw:gmatch("[^\n]+") do lines[#lines + 1] = line end
			if #lines < 2 or lines[#lines] ~= "]}" then return false, "The slot file is incomplete" end
			local nBatches = #lines - 2
			for b = 1, nBatches do
				local line = lines[b + 1]
				if line:sub(-1) == "," then line = line:sub(1, -2) end
				local okD, batch = pcall(HttpService.JSONDecode, HttpService, line)
				if not okD or type(batch) ~= "table" then return false, "The slot file is corrupted" end
				for _, frame in ipairs(batch) do
					if not validFrame(frame) then return false, "Frame " .. (#frames + 1) .. " is corrupted" end
					frames[#frames + 1] = unpackFrame(frame)
				end
				if progress then progress(b, nBatches) end
				if b < nBatches then task.wait() end
			end
			return true, frames
		end

		local okD, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if not okD or type(decoded) ~= "table" then return false, "This is not a HappaTAS slot file" end
		local lists
		if type(decoded.batches) == "table" then
			lists = decoded.batches
		else
			lists = { decoded.frames or decoded }
		end
		for _, arr in ipairs(lists) do
			if type(arr) ~= "table" then return false, "The slot file is corrupted" end
			for _, frame in ipairs(arr) do
				if not validFrame(frame) then return false, "Frame " .. (#frames + 1) .. " is corrupted" end
				frames[#frames + 1] = unpackFrame(frame)
			end
		end
		return true, frames
	end

	function Store.LoadSlot(name, progress)
		if not Store.Ready then return false, "Saving is unavailable" end
		local path = findSlotFile(name)
		if not path then return false, "The slot file does not exist" end
		local okR, raw = call(Env.readfile, path)
		if not okR or type(raw) ~= "string" then return false, "Could not read the slot file" end
		if #raw > CONFIG.MaxFileBytes then return false, "The slot file is too big" end

		if raw:sub(1, 5) == LEGACY_WRAP and #raw >= 9 then
			local b1, b2, b3, b4 = string.byte(raw, 6, 9)
			local uSize = b1 + b2 * 256 + b3 * 65536 + b4 * 16777216
			if uSize > CONFIG.MaxFileBytes then return false, "The slot file is too big" end
			local okD, decomp = pcall(Codec.Lz4Decompress, raw:sub(10), uSize)
			if not okD then return false, "The slot file is damaged (" .. tostring(decomp) .. ")" end
			raw = decomp
		end

		if Codec.IsCompact(raw) then
			local okD, frames, objects, buttons = pcall(Codec.Decode, raw, progress)
			if not okD then
				local why = tostring(frames):gsub("^[^:]*:%d+: ", "")
				return false, "The slot file is damaged (" .. why .. ")"
			end
			if objects and #objects > 0 then
				local okI, err = pcall(ClientObjects.ImportObjects, frames, objects)
				if not okI then warnf("could not map the client objects of this slot:", tostring(err)) end
			end
			if buttons and #buttons > 0 then
				local okI, err = pcall(Buttons.ImportKeys, frames, buttons)
				if not okI then warnf("could not map the buttons of this slot:", tostring(err)) end
			end
			return true, frames
		end
		return loadLegacyJson(raw, progress)
	end

	function Store.DeleteSlot(name)
		if not Store.Ready then return false, "Saving is unavailable" end
		for _, ext in ipairs({ EXT_NEW, EXT_OLD }) do
			local p = slotPath(name, ext)
			if fileExists(p) then
				local ok, err = call(Env.delfile, p)
				if not ok then return false, tostring(err) end
			end
		end
		return true
	end

	function Store.RenameSlot(old, newName)
		if not Store.Ready then return false, "Saving is unavailable" end
		newName = Store.CleanName(newName)
		if not newName then return false, "Invalid name" end
		if newName == old then return true, old end
		local oldPath, ext = findSlotFile(old)
		if not oldPath then return false, "The slot file does not exist" end
		local sameFile = newName:lower() == old:lower()
		if not sameFile and Store.Exists(newName) then return false, "A slot with that name already exists" end
		local okR, data = call(Env.readfile, oldPath)
		if not okR or type(data) ~= "string" then return false, "Could not read the slot file" end
		local newPath = slotPath(newName, ext)
		local ok = pcall(function()
			if sameFile then
				local tmp = PLACE_PATH .. "/" .. old .. "~rename" .. ext
				Env.writefile(tmp, data)
				Env.delfile(oldPath)
				Env.writefile(newPath, data)
				Env.delfile(tmp)
			else
				Env.writefile(newPath, data)
				if not Env.isfile(newPath) then error("write failed") end
				Env.delfile(oldPath)
			end
		end)
		if not ok then return false, "Rename failed" end
		return true, newName
	end

	function Store.LoadSettings()
		if not Store.Ready or not fileExists(SETTINGS_PATH) then return nil end
		local okR, raw = call(Env.readfile, SETTINGS_PATH)
		if not okR or type(raw) ~= "string" or #raw > 1048576 then return nil end
		local okD, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if okD and type(decoded) == "table" then return decoded end
		return nil
	end

	function Store.SaveSettings(tbl)
		if not Store.Ready then return false end
		local okE, json = pcall(HttpService.JSONEncode, HttpService, tbl)
		if not okE then return false end
		ensureFolders()
		return (call(Env.writefile, SETTINGS_PATH, json))
	end

	-- plain text file next to the slots (MicroProfiler dumps)
	local TEXT_EXT = { txt = true, csv = true, html = true }
	function Store.WriteText(fileName, text, ext)
		if not Store.Ready then return false, "Saving is unavailable" end
		fileName = Store.CleanName(fileName)
		if not fileName then return false, "Invalid name" end
		if not TEXT_EXT[ext or "txt"] then return false, "Invalid file type" end
		ensureFolders()
		local path = PLACE_PATH .. "/" .. fileName .. "." .. (ext or "txt")
		local ok, err = call(Env.writefile, path, text)
		if not ok then return false, tostring(err) end
		return true, path
	end

	-- optional custom sound files: HappaTasPort/Sounds/<name>.(mp3|ogg|wav)
	function Store.CustomAsset(name)
		if not Env.HasFiles or not Env.getcustomasset then return nil end
		for _, ext in ipairs({ ".mp3", ".ogg", ".wav" }) do
			local p = ROOT .. "/Sounds/" .. name .. ext
			if fileExists(p) then
				local ok, id = call(Env.getcustomasset, p)
				if ok and type(id) == "string" and id ~= "" then return id end
			end
		end
		return nil
	end
end

-- ================================================================================================
--  BRIDGE   (the game's own camera scripts: zoom, shift lock, first person, mouse lock)
--
--  * Zoom is read / written through PlayerModule's active camera controller, plus every controller
--    getgc() finds (games that run their own copy of the camera module).
--  * ZoomController.Update is wrapped so a zoom change can skip the zoom spring for one update.
--  * BaseCamera.UpdateMouseBehavior is wrapped so HappaTAS can free the mouse while paused and so
--    the character doesn't turn with the camera while it is held still.
--  * RefreshMouse() asks the camera to re-apply its mouse lock. Older camera scripts only do that
--    on events (right click, zoom change), which is why the camera used to need a right click after
--    unpausing in first person.
-- ================================================================================================
do
	local UserGameSettings
	pcall(function() UserGameSettings = UserSettings():GetService("UserGameSettings") end)

	local Default = Enum.MouseBehavior.Default
	local LockCenter = Enum.MouseBehavior.LockCenter
	local Scriptable = Enum.CameraType.Scriptable
	local FIRST_PERSON = 1.0      -- BaseCamera's FIRST_PERSON_DISTANCE_THRESHOLD

	local cameras                 -- CameraModule (PlayerModule:GetCameras())
	local patchedModule = nil
	local originals = {}          -- { table, key, original, wrapper }
	local rotate = true
	local shiftlockBlocked = false
	local freeMouse = false
	local snapUntil = 0
	local mouseLockCtrl = nil
	local zoomControllers = {}
	local gcDone = false
	local lastResolveTry = 0
	local patchedLockClasses = setmetatable({}, { __mode = "k" })

	local ghost = { last = nil, parts = {}, char = nil, tick = 0, active = false }

	local function patch(tbl, key, makeWrapper)
		if type(tbl) ~= "table" then return false end
		local ok = pcall(function()
			local orig = rawget(tbl, key) or tbl[key]
			if type(orig) ~= "function" then error("missing " .. tostring(key)) end
			local wrapper = makeWrapper(orig)
			tbl[key] = wrapper
			originals[#originals + 1] = { tbl, key, orig, wrapper }
		end)
		if not ok then log("could not patch", key) end
		return ok
	end

	local function setMouseBehavior(b)
		if UIS.MouseBehavior ~= b then pcall(function() UIS.MouseBehavior = b end) end
	end

	local function applyPatches(playerModule)
		if patchedModule == playerModule then return end
		patchedModule = playerModule
		local camMod = playerModule:FindFirstChild("CameraModule")
		if not camMod then return end
		local baseCam = camMod:FindFirstChild("BaseCamera")
		if baseCam then
			local okR, BaseCamera = pcall(require, baseCam)
			if okR and type(BaseCamera) == "table" then
				patch(BaseCamera, "UpdateMouseBehavior", function(orig)
					return function(self, ...)
						if freeMouse then
							setMouseBehavior(Default)
							return
						end
						local res = orig(self, ...)
						if not rotate and UserGameSettings and (self.inFirstPerson or self.inMouseLockedMode) then
							pcall(function() UserGameSettings.RotationType = Enum.RotationType.MovementRelative end)
						end
						return res
					end
				end)
			end
		end
		local zoomMod = camMod:FindFirstChild("ZoomController")
		if zoomMod then
			local okR, Zoom = pcall(require, zoomMod)
			if okR and type(Zoom) == "table" then
				patch(Zoom, "Update", function(orig)
					return function(renderDt, ...)
						if snapUntil > 0 then
							if os.clock() <= snapUntil and type(renderDt) == "number" then
								renderDt = renderDt * 1000000
							end
							snapUntil = 0 -- consumed by the first update after the request
						end
						return orig(renderDt, ...)
					end
				end)
			end
		end
	end

	local function scanGC()
		if gcDone or not Env.getgc then gcDone = true return end
		gcDone = true
		pcall(function()
			local n = 0
			for _, t in ipairs(Env.getgc(true)) do
				if type(t) == "table" then
					pcall(function()
						if type(rawget(t, "currentSubjectDistance")) == "number"
							and type(t.SetCameraToSubjectDistance) == "function"
							and type(t.GetCameraToSubjectDistance) == "function" then
							zoomControllers[#zoomControllers + 1] = t
						end
						if not mouseLockCtrl then
							local amc = rawget(t, "activeMouseLockController")
							if type(amc) == "table" then
								mouseLockCtrl = amc
							elseif type(t.GetIsMouseLocked) == "function" and type(t.DoMouseLockSwitch) == "function"
								and rawget(t, "isMouseLocked") ~= nil then
								mouseLockCtrl = t
							end
						end
					end)
				end
				n = n + 1
				if n % 20000 == 0 then task.wait() end
				if Janitor.unloading then break end
			end
		end)
		log(#zoomControllers .. " zoom controller(s) found")
	end

	local function resolve()
		if cameras then return cameras end
		local now = os.clock()
		if now - lastResolveTry < 1 then return nil end -- don't re-require every frame while it's missing
		lastResolveTry = now
		local ps = LocalPlayer:FindFirstChild("PlayerScripts")
		local pm = ps and ps:FindFirstChild("PlayerModule")
		if not pm then return nil end
		local ok, mod = pcall(require, pm)
		if not ok or type(mod) ~= "table" then return nil end
		local cams
		pcall(function()
			if type(mod.GetCameras) == "function" then cams = mod:GetCameras() end
			if not cams and type(mod.cameras) == "table" then cams = mod.cameras end
		end)
		if cams then
			cameras = cams
			applyPatches(pm)
			if not mouseLockCtrl and type(cams.activeMouseLockController) == "table" then
				mouseLockCtrl = cams.activeMouseLockController
			end
		end
		return cameras
	end

	local function activeController()
		local cams = resolve()
		local ctrl = cams and cams.activeCameraController
		if type(ctrl) == "table" then return ctrl end
		return nil
	end
	Bridge.Controller = activeController

	function Bridge.Init()
		task.spawn(scanGC)
		task.spawn(function()
			local t0 = os.clock()
			while not Janitor.unloading and not resolve() and os.clock() - t0 < 120 do
				task.wait(0.5)
			end
			if not cameras and not Janitor.unloading then
				warnf("Could not find the game's PlayerModule, zoom/shiftlock syncing is limited.")
			end
		end)
	end

	function Bridge.GetZoom()
		local ctrl = activeController()
		if ctrl and type(ctrl.GetCameraToSubjectDistance) == "function" then
			local ok, z = pcall(ctrl.GetCameraToSubjectDistance, ctrl)
			if ok and type(z) == "number" and z == z then return z end
		end
		for _, zc in ipairs(zoomControllers) do
			local ok, z = pcall(zc.GetCameraToSubjectDistance, zc)
			if ok and type(z) == "number" and z == z and z ~= 12.5 then return z end
		end
		local cam = workspace.CurrentCamera
		if cam then
			return (cam.CFrame.Position - cam.Focus.Position).Magnitude
		end
		return 12.5
	end

	function Bridge.RemoveZoomSpring()
		snapUntil = os.clock() + 0.25
	end

	-- static = land on the zoom instantly (no spring)
	function Bridge.SetZoom(zoom, static)
		if type(zoom) ~= "number" or zoom ~= zoom or zoom == math.huge or zoom <= 0 then return end
		if static then Bridge.RemoveZoomSpring() end
		local ctrl = activeController()
		if ctrl and type(ctrl.SetCameraToSubjectDistance) == "function" then
			local okG, cur = pcall(ctrl.GetCameraToSubjectDistance, ctrl)
			local same = okG and type(cur) == "number" and math.abs(cur - zoom) < 1e-4
				and not (zoom < FIRST_PERSON and ctrl.inFirstPerson == false)
			if not same then pcall(ctrl.SetCameraToSubjectDistance, ctrl, zoom) end
		end
		for _, zc in ipairs(zoomControllers) do
			if zc ~= ctrl then
				local okG, cur = pcall(zc.GetCameraToSubjectDistance, zc)
				if not (okG and type(cur) == "number" and math.abs(cur - zoom) < 1e-4) then
					pcall(zc.SetCameraToSubjectDistance, zc, zoom)
				end
			end
		end
	end

	-- --------------------------------------------------------------------------------------------
	--  GHOST MODE: the camera script's see-through character does not run while the camera is
	--  Scriptable (test playback), so the same maths is applied here.
	-- --------------------------------------------------------------------------------------------
	local function collectGhostParts(char)
		local list = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d:FindFirstAncestorWhichIsA("Tool") then
				list[#list + 1] = d
			end
		end
		return list
	end

	function Bridge.UpdateGhost(zoom, dt)
		local char = LocalPlayer.Character
		if not char then return end
		zoom = tonumber(zoom) or 12.5
		local target = 0
		if zoom < 2 then target = 1 - (zoom - 0.5) / 1.5 end
		if target < 0.5 then target = 0 end
		local value = target
		if ghost.last ~= nil then
			local maxDelta = 2.8 * (dt or 0.016)
			value = ghost.last + clampn(target - ghost.last, -maxDelta, maxDelta)
		end
		value = clampn(math.floor(value * 100 + 0.5) / 100, 0, 1)
		ghost.tick = ghost.tick + 1
		local rebuild = ghost.char ~= char or ghost.tick % 60 == 1
		if rebuild then
			ghost.char = char
			ghost.parts = collectGhostParts(char)
		end
		if rebuild or value ~= ghost.last then
			for _, part in ipairs(ghost.parts) do
				if part.Parent then part.LocalTransparencyModifier = value end
			end
		end
		ghost.last = value
		ghost.active = true
	end

	function Bridge.ResetGhost()
		if not ghost.active then return end
		ghost.active = false
		ghost.last = nil
		for _, part in ipairs(ghost.parts) do
			if part.Parent then part.LocalTransparencyModifier = 0 end
		end
		ghost.parts = {}
		pcall(function()
			local cams = resolve()
			local tc = cams and cams.activeTransparencyController
			if tc then
				tc.lastTransparency = nil
				tc.transparencyDirty = true
			end
		end)
	end

	-- --------------------------------------------------------------------------------------------
	--  SHIFT LOCK / FIRST PERSON / MOUSE
	-- --------------------------------------------------------------------------------------------
	local function lockController()
		if mouseLockCtrl then return mouseLockCtrl end
		local cams = resolve()
		if cams and type(cams.activeMouseLockController) == "table" then
			mouseLockCtrl = cams.activeMouseLockController
		end
		return mouseLockCtrl
	end

	local mouseObj
	function Bridge.IsShiftlocked()
		local ctrl = lockController()
		if ctrl then
			if type(ctrl.GetIsMouseLocked) == "function" then
				local ok, locked = pcall(ctrl.GetIsMouseLocked, ctrl)
				if ok and type(locked) == "boolean" then return locked end
			end
			if type(ctrl.isMouseLocked) == "boolean" then return ctrl.isMouseLocked end
		end
		if not mouseObj then pcall(function() mouseObj = LocalPlayer:GetMouse() end) end
		return mouseObj ~= nil and mouseObj.Icon == "rbxasset://textures/MouseLockedCursor.png"
	end

	function Bridge.ShiftlockSwitch()
		local ctrl = lockController()
		if not ctrl then return end
		if type(ctrl.OnMouseLockToggled) == "function" then
			pcall(ctrl.OnMouseLockToggled, ctrl)
		elseif type(ctrl.DoMouseLockSwitch) == "function" then
			local wasBlocked = shiftlockBlocked
			shiftlockBlocked = false
			pcall(ctrl.DoMouseLockSwitch, ctrl, "MouseLockSwitchAction", Enum.UserInputState.Begin, game)
			shiftlockBlocked = wasBlocked
		end
	end

	-- while testing the player can't toggle shift lock by hand (the TAS does it)
	function Bridge.LockShiftlock(lock)
		shiftlockBlocked = lock and true or false
		local ctrl = lockController()
		if not ctrl then return end
		local cls = getmetatable(ctrl)
		if type(cls) == "table" and not patchedLockClasses[cls] and type(cls.DoMouseLockSwitch) == "function" then
			patchedLockClasses[cls] = true
			patch(cls, "DoMouseLockSwitch", function(orig)
				return function(self, name, state, input, ...)
					if shiftlockBlocked then return Enum.ContextActionResult.Pass end
					return orig(self, name, state, input, ...)
				end
			end)
		end
	end

	function Bridge.IsInFirstPerson()
		local ctrl = activeController()
		if ctrl and type(ctrl.inFirstPerson) == "boolean" then
			return ctrl.inFirstPerson
		end
		return Bridge.GetZoom() < FIRST_PERSON
	end

	-- free = the mouse can move freely (paused with a locked camera, testing with a scriptable camera)
	function Bridge.SetFreeMouse(free)
		free = free and true or false
		if freeMouse == free then return end
		freeMouse = free
		if free then
			setMouseBehavior(Default)
		else
			Bridge.RefreshMouse()
		end
	end
	function Bridge.IsMouseFree() return freeMouse end

	local function rotationFor(locked)
		if not UserGameSettings then return end
		local want = (locked and rotate) and Enum.RotationType.CameraRelative or Enum.RotationType.MovementRelative
		if UserGameSettings.RotationType ~= want then
			pcall(function() UserGameSettings.RotationType = want end)
		end
	end

	-- modalOpen: a HappaTAS window is open (its Modal button frees the mouse, don't lock it again)
	function Bridge.GuardMouse(modalOpen)
		if freeMouse then
			setMouseBehavior(Default)
			return
		end
		if modalOpen or (GuiService and GuiService.MenuIsOpen) then return end
		local cam = workspace.CurrentCamera
		if not cam or cam.CameraType == Scriptable then return end
		local locked = Bridge.IsInFirstPerson() or Bridge.IsShiftlocked()
		if locked and UIS.MouseBehavior == Default then
			setMouseBehavior(LockCenter)
			rotationFor(true)
		end
	end

	-- asks the camera script to apply its mouse lock again (fixes the "right click needed" bug)
	function Bridge.RefreshMouse(modalOpen)
		if freeMouse then setMouseBehavior(Default) return end
		local ctrl = activeController()
		if ctrl and type(ctrl.UpdateMouseBehavior) == "function" then
			pcall(ctrl.UpdateMouseBehavior, ctrl)
		end
		Bridge.GuardMouse(modalOpen)
	end

	function Bridge.ShiftlockRotation(value)
		rotate = value and true or false
		local locked = Bridge.IsInFirstPerson() or Bridge.IsShiftlocked()
		rotationFor(locked)
		Bridge.RefreshMouse()
	end

	function Bridge.Restore()
		pcall(Bridge.ResetGhost)
		shiftlockBlocked = false
		snapUntil = 0
		rotate = true
		freeMouse = false
		for i = #originals, 1, -1 do
			local o = originals[i]
			pcall(function()
				if o[1][o[2]] == o[4] then o[1][o[2]] = o[3] end
			end)
		end
		originals = {}
		patchedModule = nil
		pcall(Bridge.RefreshMouse)
	end

	-- the animation engine fills these in
	function Bridge.GetAnimation() return nil end
	function Bridge.SetAnimation() end
	function Bridge.LockAnimations() end
end

-- ================================================================================================
--  INPUTS   (keyboard + mouse recording and replay through the executor's input functions)
--
--  Key ids are part of the file format (A-Z = 1-26, 0-9 = 27-36, ... LMB 96, RMB 97): never reorder.
--  A frame stores a list of events: id = pressed, -id = released, 10000 + n = n wheel notches.
-- ================================================================================================
do
	local floor = math.floor

	InputSys.Available = {
		Keys = Env.keypress ~= nil and Env.keyrelease ~= nil,
		Clicks = Env.mouse1press ~= nil and Env.mouse1release ~= nil and Env.mouse2press ~= nil and Env.mouse2release ~= nil,
		Move = Env.mousemoveabs ~= nil,
		Scroll = Env.mousescroll ~= nil,
	}

	local SCROLL_BASE = Codec.ScrollBase
	local SCROLL_LIMIT = SCROLL_BASE - 5000
	local SCROLL_UNIT = 120

	local KEYLIST = {
		{ "A", 0x41, "A" }, { "B", 0x42, "B" }, { "C", 0x43, "C" }, { "D", 0x44, "D" }, { "E", 0x45, "E" }, { "F", 0x46, "F" },
		{ "G", 0x47, "G" }, { "H", 0x48, "H" }, { "I", 0x49, "I" }, { "J", 0x4A, "J" }, { "K", 0x4B, "K" }, { "L", 0x4C, "L" },
		{ "M", 0x4D, "M" }, { "N", 0x4E, "N" }, { "O", 0x4F, "O" }, { "P", 0x50, "P" }, { "Q", 0x51, "Q" }, { "R", 0x52, "R" },
		{ "S", 0x53, "S" }, { "T", 0x54, "T" }, { "U", 0x55, "U" }, { "V", 0x56, "V" }, { "W", 0x57, "W" }, { "X", 0x58, "X" },
		{ "Y", 0x59, "Y" }, { "Z", 0x5A, "Z" },
		{ "Zero", 0x30, "0" }, { "One", 0x31, "1" }, { "Two", 0x32, "2" }, { "Three", 0x33, "3" }, { "Four", 0x34, "4" },
		{ "Five", 0x35, "5" }, { "Six", 0x36, "6" }, { "Seven", 0x37, "7" }, { "Eight", 0x38, "8" }, { "Nine", 0x39, "9" },
		{ "Space", 0x20, "Space" }, { "Return", 0x0D, "Enter" }, { "Tab", 0x09, "Tab" }, { "Backspace", 0x08, "Bksp" },
		{ "LeftShift", 0xA0, "LShift" }, { "RightShift", 0xA1, "RShift" }, { "LeftControl", 0xA2, "LCtrl" },
		{ "RightControl", 0xA3, "RCtrl" }, { "LeftAlt", 0xA4, "LAlt" }, { "RightAlt", 0xA5, "RAlt" },
		{ "Up", 0x26, "Up" }, { "Down", 0x28, "Down" }, { "Left", 0x25, "Left" }, { "Right", 0x27, "Right" },
		{ "Insert", 0x2D, "Ins" }, { "Delete", 0x2E, "Del" }, { "Home", 0x24, "Home" }, { "End", 0x23, "End" },
		{ "PageUp", 0x21, "PgUp" }, { "PageDown", 0x22, "PgDn" },
		{ "F1", 0x70, "F1" }, { "F2", 0x71, "F2" }, { "F3", 0x72, "F3" }, { "F4", 0x73, "F4" }, { "F5", 0x74, "F5" },
		{ "F6", 0x75, "F6" }, { "F7", 0x76, "F7" }, { "F8", 0x77, "F8" }, { "F9", 0x78, "F9" }, { "F10", 0x79, "F10" },
		{ "F11", 0x7A, "F11" }, { "F12", 0x7B, "F12" },
		{ "Minus", 0xBD, "-" }, { "Equals", 0xBB, "=" }, { "LeftBracket", 0xDB, "[" }, { "RightBracket", 0xDD, "]" },
		{ "BackSlash", 0xDC, "\\" }, { "Semicolon", 0xBA, ";" }, { "Quote", 0xDE, "'" }, { "Comma", 0xBC, "," },
		{ "Period", 0xBE, "." }, { "Slash", 0xBF, "/" }, { "Backquote", 0xC0, "`" }, { "CapsLock", 0x14, "Caps" },
		{ "KeypadZero", 0x60, "Num0" }, { "KeypadOne", 0x61, "Num1" }, { "KeypadTwo", 0x62, "Num2" },
		{ "KeypadThree", 0x63, "Num3" }, { "KeypadFour", 0x64, "Num4" }, { "KeypadFive", 0x65, "Num5" },
		{ "KeypadSix", 0x66, "Num6" }, { "KeypadSeven", 0x67, "Num7" }, { "KeypadEight", 0x68, "Num8" },
		{ "KeypadNine", 0x69, "Num9" }, { "KeypadMultiply", 0x6A, "Num*" }, { "KeypadPlus", 0x6B, "Num+" },
		{ "KeypadMinus", 0x6D, "Num-" }, { "KeypadPeriod", 0x6E, "Num." }, { "KeypadDivide", 0x6F, "Num/" },
		{ false, false, "LMB" }, { false, false, "RMB" },
	}
	local ID_M1, ID_M2 = 96, 97
	InputSys.ID_M1, InputSys.ID_M2 = ID_M1, ID_M2

	local KEY_BY_ENUM, KEY_VK, KEY_SHORT = {}, {}, {}
	for id, k in ipairs(KEYLIST) do
		KEY_SHORT[id] = k[3]
		if k[1] then
			local ok, item = pcall(function() return Enum.KeyCode[k[1]] end)
			if ok and item then
				KEY_BY_ENUM[item] = id
				KEY_VK[id] = k[2]
			end
		end
	end

	local function isMouseId(id) return id == ID_M1 or id == ID_M2 end

	-- keys bound to HappaTAS controls are never recorded or replayed
	local controlIds, controlDirty = {}, true
	Controls.Changed("*", function() controlDirty = true end)
	local function getControlIds()
		if controlDirty then
			controlDirty = false
			controlIds = {}
			for _, cdef in ipairs(ControlsTable) do
				local item = ToKey[Controls.Get(cdef[1]) or ""]
				if item then
					if item == Enum.UserInputType.MouseButton1 then controlIds[ID_M1] = true
					elseif item == Enum.UserInputType.MouseButton2 then controlIds[ID_M2] = true
					elseif KEY_BY_ENUM[item] then controlIds[KEY_BY_ENUM[item]] = true end
				end
			end
		end
		return controlIds
	end

	local live = { held = {} }
	local queue = {}
	local ownWindows = {}
	InputSys.Live = live

	local function pushEvent(e)
		queue[#queue + 1] = e
		if #queue > 256 then table.remove(queue, 1) end
	end

	local function overOwnUI()
		local okM, m = pcall(UIS.GetMouseLocation, UIS)
		if not okM then return false end
		local inset = Vector2.zero
		if GuiService then pcall(function() inset = GuiService:GetGuiInset() end) end
		for _, f in ipairs(ownWindows) do
			if f and f.Visible then
				local p, s = f.AbsolutePosition, f.AbsoluteSize
				local x, y = m.X - inset.X, m.Y - inset.Y
				if x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y then return true end
				x, y = m.X, m.Y
				if x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y then return true end
			end
		end
		return Profiler.IsMouseOver ~= nil and Profiler.IsMouseOver(m) or false
	end

	local function idOf(inp)
		local t = inp.UserInputType
		if t == Enum.UserInputType.Keyboard then
			return KEY_BY_ENUM[inp.KeyCode]
		elseif t == Enum.UserInputType.MouseButton1 then
			return ID_M1
		elseif t == Enum.UserInputType.MouseButton2 then
			return ID_M2
		end
		return nil
	end
	InputSys.IdOf = idOf

	local function ignoring()
		if UIS:GetFocusedTextBox() ~= nil then return true end
		if GuiService and GuiService.MenuIsOpen then return true end
		return false
	end

	local function onBegan(inp, proc)
		if proc and not Settings.On("Ignore Game Processed") then return end
		local id = idOf(inp)
		if not id or getControlIds()[id] or ignoring() then return end
		if isMouseId(id) and overOwnUI() then return end
		if live.held[id] then return end
		live.held[id] = true
		pushEvent(id)
		if Sounds.PlayLive then Sounds.PlayLive(id, isMouseId(id), id == ID_M2) end
	end

	local function onEnded(inp, proc)
		local id = idOf(inp)
		if id and live.held[id] then
			live.held[id] = nil
			pushEvent(-id)
		end
	end

	local function onChanged(inp)
		if inp.UserInputType ~= Enum.UserInputType.MouseWheel then return end
		if ignoring() or overOwnUI() then return end
		pushEvent(SCROLL_BASE + (inp.Position.Z > 0 and 1 or -1))
	end

	local function onFocusLost()
		for id in pairs(live.held) do pushEvent(-id) end
		live.held = {}
	end

	function InputSys.Take()
		if #queue == 0 then return nil end
		local q = queue
		queue = {}
		return q
	end

	function InputSys.Clear()
		if #queue > 0 then queue = {} end
	end

	-- mouse position in window pixels + the same position normalised to the viewport (0..1)
	function InputSys.Mouse()
		local v = UIS:GetMouseLocation()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		local mx, my = floor(v.X + 0.5), floor(v.Y + 0.5)
		local vx, vy = vp.X, vp.Y
		local uvx = vx > 0 and clampn(mx / vx, 0, 1) or 0.5
		local uvy = vy > 0 and clampn(my / vy, 0, 1) or 0.5
		return mx, my, uvx, uvy, vx, vy
	end

	function InputSys.HeldAt(data, upTo, base)
		local set = {}
		if base then for id in pairs(base) do set[id] = true end end
		for i = 1, math.min(upTo, #data) do
			local ev = data[i].Input
			if ev then
				for k = 1, #ev do
					local e = ev[k]
					if e < SCROLL_LIMIT then
						if e > 0 then set[e] = true else set[-e] = nil end
					end
				end
			end
		end
		return set
	end

	-- unpausing: tell the recording which keys go up / down compared to the frame we resume from
	function InputSys.BeginRecording(data, base)
		queue = {}
		local want = InputSys.HeldAt(data, #data, base)
		local ids = {}
		for id in pairs(want) do if not live.held[id] then ids[#ids + 1] = -id end end
		for id in pairs(live.held) do if not want[id] then ids[#ids + 1] = id end end
		table.sort(ids, function(a, b) return math.abs(a) < math.abs(b) end)
		for _, e in ipairs(ids) do queue[#queue + 1] = e end
	end

	function InputSys.Describe(set)
		local ids = {}
		for id in pairs(set) do ids[#ids + 1] = id end
		if #ids == 0 then return "-" end
		table.sort(ids)
		local names = {}
		for i, id in ipairs(ids) do names[i] = KEY_SHORT[id] or "?" end
		return table.concat(names, " ")
	end

	-- ------------------------------------------------------------------------------------ replay
	local replay = { active = false, applied = 0, injected = {}, state = {}, lastMX = nil, lastMY = nil }
	InputSys.Replay = replay

	local function allowed(id)
		if getControlIds()[id] then return false end
		if isMouseId(id) then return InputSys.Available.Clicks and Settings.On("Replay Mouse Clicks") end
		return InputSys.Available.Keys and Settings.On("Replay Keyboard") and KEY_VK[id] ~= nil
	end

	local function sendDown(id)
		return (pcall(function()
			if id == ID_M1 then Env.mouse1press() elseif id == ID_M2 then Env.mouse2press() else Env.keypress(KEY_VK[id]) end
		end))
	end
	local function sendUp(id)
		pcall(function()
			if id == ID_M1 then Env.mouse1release() elseif id == ID_M2 then Env.mouse2release() else Env.keyrelease(KEY_VK[id]) end
		end)
	end

	local function press(id)
		replay.state[id] = true
		if replay.injected[id] or not allowed(id) or not Env.WindowActive() then return end
		if sendDown(id) then replay.injected[id] = true end
	end
	local function release(id)
		replay.state[id] = nil
		if replay.injected[id] then
			sendUp(id)
			replay.injected[id] = nil
		end
	end

	local function applyEvent(e)
		if e >= SCROLL_LIMIT then
			local notches = e - SCROLL_BASE
			if notches ~= 0 and InputSys.Available.Scroll and Settings.On("Replay Mouse Clicks") and Env.WindowActive() then
				pcall(Env.mousescroll, notches * SCROLL_UNIT)
			end
		elseif e > 0 then
			press(e)
			if Sounds.PlayReplay then Sounds.PlayReplay(e, isMouseId(e), e == ID_M2) end
		else
			release(-e)
		end
	end

	local function syncTo(desired)
		for id in pairs(replay.injected) do
			if not desired[id] then release(id) end
		end
		for id in pairs(replay.state) do
			if not desired[id] then replay.state[id] = nil end
		end
		for id in pairs(desired) do
			if not replay.state[id] or not replay.injected[id] then press(id) end
		end
	end

	function InputSys.IsReplaying() return replay.active end

	function InputSys.ReplayBegin(data, startFrame)
		InputSys.ReplayEnd()
		replay.active = true
		replay.applied = startFrame - 1
		syncTo(InputSys.HeldAt(data, startFrame - 1))
	end

	function InputSys.ReplayTo(data, frame)
		if not replay.active then return end
		if frame > replay.applied then
			for f = replay.applied + 1, math.min(frame, #data) do
				local ev = data[f].Input
				if ev then
					for k = 1, #ev do applyEvent(ev[k]) end
				end
			end
		elseif frame < replay.applied then
			syncTo(InputSys.HeldAt(data, frame))
		end
		replay.applied = frame
	end

	-- true when the camera had the mouse locked on this recorded frame (shift lock, first person, right click)
	function InputSys.FrameLocked(fr)
		if not fr then return false end
		if fr.ShiftLock == 1 then return true end
		if (fr.Zoom or 99) < 1 then return true end
		return replay.state[ID_M2] == true
	end

	-- where the recorded cursor was, mapped to this window
	function InputSys.FramePoint(fr)
		if not fr or fr.MX == nil then return nil end
		if Settings.On("Normalize Mouse UV") and fr.UVX and fr.UVY then
			local cam = workspace.CurrentCamera
			local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
			return floor(fr.UVX * vp.X + 0.5), floor(fr.UVY * vp.Y + 0.5)
		end
		return fr.MX, fr.MY
	end

	function InputSys.MoveRealMouse(x, y)
		if not InputSys.Available.Move or not Env.WindowActive() then return end
		x, y = floor(x + 0.5), floor(y + 0.5)
		if x == replay.lastMX and y == replay.lastMY then return end
		replay.lastMX, replay.lastMY = x, y
		pcall(Env.mousemoveabs, x, y)
	end

	function InputSys.ReplayMouse(fr)
		if not replay.active or not fr or fr.MX == nil then return end
		if not Settings.On("Replay Mouse Movement") then return end
		if InputSys.FrameLocked(fr) then return end -- the cursor module moves the hidden cursor then
		local tx, ty = InputSys.FramePoint(fr)
		if tx then InputSys.MoveRealMouse(tx, ty) end
	end

	function InputSys.ReplayEnd()
		local had = replay.active
		for id in pairs(replay.injected) do sendUp(id) end
		replay.injected = {}
		replay.state = {}
		replay.active = false
		replay.applied = 0
		replay.lastMX, replay.lastMY = nil, nil
		return had
	end

	function InputSys.Start(gui)
		ownWindows = { gui.MainMenu, gui.Merge, gui.MergeStats, gui.JoinMessage }
		on(UIS.InputBegan, onBegan)
		on(UIS.InputEnded, onEnded)
		on(UIS.InputChanged, onChanged)
		pcall(function() on(UIS.WindowFocusReleased, onFocusLost) end)
		Janitor.add(function() InputSys.ReplayEnd() end)
	end
end

-- ================================================================================================
--  CURSOR  (NohBoard fake cursor)
--
--  While the camera has the mouse locked (right click, shift lock, first person) a fake cursor
--  image stays where the cursor was and the real cursor is hidden.
--   * Creating: the fake cursor is shown on the same pixel as the real one FIRST, the real cursor is
--     hidden two frames later. The real cursor is drawn by the OS straight away while GUI changes
--     reach the screen a frame or two later, so hiding both at once used to leave a gap.
--   * Testing: the real cursor stays hidden for the whole replay, the fake one shows the recorded
--     cursor. While the recording had the camera locked, the hidden real cursor is moved the way the
--     mouse moved the camera, so NohBoard shows the mouse movement.
-- ================================================================================================
do
	local ARROW = { "rbxasset://textures/Cursors/KeyboardMouse/ArrowFarCursor.png", 64 }
	local LOCKED = { "rbxasset://textures/MouseLockedCursor.png", 32 }
	local HIDE_DELAY = 2 -- frames the real and fake cursor overlap before the real one is hidden
	local Default = Enum.MouseBehavior.Default

	local UserGameSettings
	pcall(function() UserGameSettings = UserSettings():GetService("UserGameSettings") end)

	local sg, img
	local st = {
		fake = false, realHidden = false, hideAt = nil, icon = nil, prevIcon = true,
		test = false, wasLocked = false, anchorX = 0, anchorY = 0, virtX = 0, virtY = 0,
		lastYaw = nil, lastPitch = nil, lastFrame = nil,
	}
	local frameNo = 0

	local function ensure()
		if img and img.Parent then return true end
		sg = sg or UI.Overlay("HappaCursor", 2147483000)
		if not sg then return false end
		img = Instance.new("ImageLabel")
		img.Name = "Cursor"
		img.BackgroundTransparency = 1
		img.BorderSizePixel = 0
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.ZIndex = 10
		img.Active = false
		img.Visible = false
		img.Parent = sg
		st.icon = nil
		return true
	end

	local function setIcon(which)
		if st.icon == which then return end
		st.icon = which
		img.Image = which[1]
		img.Size = UDim2.fromOffset(which[2], which[2])
	end

	local lastPX, lastPY
	local function showFakeAt(x, y)
		x, y = math.floor(x + 0.5), math.floor(y + 0.5)
		if x ~= lastPX or y ~= lastPY then
			lastPX, lastPY = x, y
			img.Position = UDim2.fromOffset(x, y)
		end
		if not st.fake then
			st.fake = true
			img.Visible = true
		end
	end
	local function hideFake()
		if st.fake then
			st.fake = false
			if img then img.Visible = false end
		end
	end
	local function hideReal()
		if st.realHidden then return end
		st.prevIcon = UIS.MouseIconEnabled
		st.realHidden = true
		pcall(function() UIS.MouseIconEnabled = false end)
	end
	local function showReal()
		if not st.realHidden then return end
		st.realHidden = false
		pcall(function() UIS.MouseIconEnabled = st.prevIcon ~= false end)
	end

	function Cursor.Reset()
		showReal()
		hideFake()
		st.hideAt = nil
		st.test = false
		st.wasLocked = false
		st.lastYaw, st.lastPitch, st.lastFrame = nil, nil, nil
	end

	local function viewportCenter()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		return vp.X / 2, vp.Y / 2, vp
	end

	-- camera yaw / pitch (radians) from a recorded camera CFrame table
	local function yawPitch(cc)
		local yaw = math.atan2(cc[6], cc[12])
		local pitch = math.asin(clampn(-cc[9], -1, 1))
		return yaw, pitch
	end

	local function sensitivity()
		local s = 1
		if UserGameSettings then pcall(function() s = UserGameSettings.MouseSensitivity end) end
		if type(s) ~= "number" or s <= 0 then s = 1 end
		return s
	end

	local function testStep(fr)
		if not st.test then
			st.test = true
			st.wasLocked = false
			st.lastYaw, st.lastPitch, st.lastFrame = nil, nil, nil
			st.hideAt = nil
			hideReal()
		end
		if not fr then return end
		local cx, cy, vp = viewportCenter()
		local px, py = InputSys.FramePoint(fr)
		local locked = InputSys.FrameLocked(fr)
		local centered = fr.ShiftLock == 1 or (fr.Zoom or 99) < 1
		if locked then
			if not st.wasLocked then
				if centered then st.anchorX, st.anchorY = cx, cy
				else st.anchorX, st.anchorY = px or cx, py or cy end
				st.virtX, st.virtY = px or st.anchorX, py or st.anchorY
				st.lastYaw = nil
			end
			if centered then st.anchorX, st.anchorY = cx, cy end
			setIcon(fr.ShiftLock == 1 and LOCKED or ARROW)
			showFakeAt(st.anchorX, st.anchorY)
			-- the hidden real cursor follows the camera like the mouse did (NohBoard)
			if fr ~= st.lastFrame and type(fr.CamCframe) == "table" then
				local yaw, pitch = yawPitch(fr.CamCframe)
				if st.lastYaw then
					local dy, dp = yaw - st.lastYaw, pitch - st.lastPitch
					if dy > math.pi then dy = dy - 2 * math.pi elseif dy < -math.pi then dy = dy + 2 * math.pi end
					local mult = Settings.Get("Invisible Mouse Speed Multiplier")
					if mult <= 0 then mult = 1 end
					local sens = sensitivity()
					-- Roblox camera: 0.002*pi rad per pixel horizontally, 0.0015*pi vertically (x sensitivity)
					local mx = -dy / (0.002 * math.pi * sens) * mult
					local my = -dp / (0.0015 * math.pi * sens) * mult
					if math.abs(mx) > 0.05 or math.abs(my) > 0.05 then
						st.virtX = clampn(st.virtX + mx, 2, vp.X - 2)
						st.virtY = clampn(st.virtY + my, 2, vp.Y - 2)
						if Settings.On("Replay Mouse Movement") then InputSys.MoveRealMouse(st.virtX, st.virtY) end
					end
				end
				st.lastYaw, st.lastPitch = yaw, pitch
			end
		else
			setIcon(ARROW)
			if px then showFakeAt(px, py) end
			st.lastYaw = nil
		end
		st.lastFrame = fr
		st.wasLocked = locked
	end

	-- called once per frame after the camera has updated
	function Cursor.Update(mode, fr, menuOpen)
		frameNo = frameNo + 1
		if not Settings.On("NohBoard Cursor") or not UIS.MouseEnabled then
			if st.fake or st.realHidden then Cursor.Reset() end
			return
		end
		if mode == 3 then
			if not ensure() then return end
			testStep(fr)
			return
		end
		if st.test then Cursor.Reset() end
		if mode ~= 2 then
			if st.fake or st.realHidden then Cursor.Reset() end
			return
		end
		local mb = UIS.MouseBehavior
		local locked = mb ~= Default and not Bridge.IsMouseFree() and not menuOpen
		if locked then
			if not ensure() then return end
			local m = UIS:GetMouseLocation()
			setIcon(Bridge.IsShiftlocked() and LOCKED or ARROW)
			if not st.fake then
				st.hideAt = frameNo + HIDE_DELAY
			end
			showFakeAt(m.X, m.Y)
			if st.hideAt and frameNo >= st.hideAt then
				st.hideAt = nil
				hideReal()
			end
		elseif st.fake or st.realHidden then
			-- the real cursor comes back instantly (OS), the fake one disappears a frame later on screen
			showReal()
			hideFake()
			st.hideAt = nil
		end
	end

	Janitor.add(function() Cursor.Reset() end)
end

