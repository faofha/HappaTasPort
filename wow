			if sLabel.Text ~= formatted then
				suppressLabelText[sLabel] = true
				pcall(function() sLabel.Text = formatted end)
				suppressLabelText[sLabel] = nil
			end
			if not sLabel.Visible then pcall(function() sLabel.Visible = true end) end
		end
