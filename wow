				else
					show(row.sq, false)
				end
			end
			for i = #rows + 1, w.n do
				local row = w.rows[i]
				show(row.l, false)
				show(row.v, false)
				show(row.sq, false)
			end
			w.n = #rows
			w.x, w.y, w.w, w.h = x - 1, y - 1, ww + 2, hh + 2
			show(w.outer, true)
		end
