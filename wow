		local byPath, resolved = {}, {}
		for _, n in ipairs(tree) do
			node(n, styles, resolved, "", byPath).Parent = parent
		end
		return parent, byPath
	end
	function ClassicBuild.node(n, styles)
		return node(n, styles, {}, "", nil)
	end
