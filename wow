				AG.dframes, AG.dsum, AG.dmax = AG.count, AG.sum, AG.max
				for j = 1, NT do
					TV.dT[j], TV.dMax[j], TV.dC[j], TV.dX[j], TV.dXMax[j] = TV.aT[j], TV.aMax[j], TV.aC[j], TV.aX[j], TV.aXMax[j]
