			task.wait()
			local ok, res = pcall(function()
				local data = Run.build(E.tl, clean)
				local okS, rel = E.library:save(clean, folder, data)
				if not okS then error(rel, 0) end
				return rel
			end)
			if ok then
				done(E, "save", true, "Saved " .. clean, res)
