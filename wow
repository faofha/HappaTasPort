			local pa = RAW.pa[j]
			HIS.pa[i], HIS.ps[i], HIS.po[i], HIS.hb[i], HIS.pr[i] = pa, RAW.ps[j], RAW.po[j], RAW.hb[j], RAW.pr[j]
			if pa then
