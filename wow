				if stage ~= "PostSimulation" then P.End("HappaTAS") end
				if stage == "PreRender" then P.FrameEnd() end
			end,
			entryBegin = function(e)
				local kind = ENTRY_SCOPE[e.name]
				local name = false
				if kind == "ui" then
					name = "Stats UI"
				elseif E.mode == 3 then
					if kind == "play" or kind == "both" then name = "Playback" end
				elseif E.mode == 2 and not E.paused then
					if kind == "rec" or kind == "both" then name = "Record" end
				end
				entries[#entries + 1] = name
				if name then scopeBegin(name) end
			end,
			entryEnd = function()
				local name = entries[#entries]
				entries[#entries] = nil
				if name then scopeEnd(name) end
			end,
		}
		local held, recOff = {}, false
		local plugHook = {
			names = TIMED,
			begin = function(name)
				local scope = SCOPE[name]
				if not scope then return end
				local pause = not recOff and (depth.Record or 0) > 0
				held[#held + 1] = pause
				if pause then recOff = true; P.End("Record") end
				scopeBegin(scope)
			end,
			finish = function(name)
				local scope = SCOPE[name]
				if not scope then return end
				scopeEnd(scope)
				local pause = held[#held]
				held[#held] = nil
				if pause then recOff = false; P.Begin("Record") end
			end,
		}
		local function feed(on)
			table.clear(depth)
			table.clear(entries)
			table.clear(held)
			recOff = false
			E.pipe.profiler = on and pipeHook or nil
			Plugins.prof = on and plugHook or nil
		end
		local setVisible = P.SetVisible
		P.SetVisible = function(v)
			setVisible(v)
			feed(P.active == true)
		end
		local uis = Env.svc("UserInputService")
		life:connect(uis.InputBegan, function(inp)
			if E.typing:active(inp) then return end
			if E.controls:matches(inp, "microProfiler") then
				s:set("showMicroProfiler", s:on("showMicroProfiler") and 0 or 1)
				return
			end
			if inp.KeyCode == Enum.KeyCode.P and P.active
				and (uis:IsKeyDown(Enum.KeyCode.LeftControl) or uis:IsKeyDown(Enum.KeyCode.RightControl)) then
				P.TogglePause()
			end
		end)
		life:own(function()
			feed(false)
			if P.active then pcall(setVisible, false) end
		end)
		local saved = E.settingsFile and E.settingsFile:getProfiler()
		if type(saved) == "table" then pcall(P.LoadConfig, saved) end
		P.Start()
		return P
	end
	return ProfilerApp
end
