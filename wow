		local function selectRow(path)
			lw.selected = path
			local e = path and entryOf(path)
			if e then lw.nameField:set(e.name) end
			for _, r in ipairs(lw.rows) do
				W.set(r.gui, "BackgroundTransparency", (r.entry.path == path) and 0.84 or 1)
			end
			setConfirm(nil)
			showInfo()
			updateButtons()
		end
